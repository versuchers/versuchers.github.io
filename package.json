{
  "name": "default-project",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "fetch": "node scripts/fetch-sheets.mjs",
    "fonts": "python3 scripts/fetch-fonts.py",
    "music": "node scripts/build-music.mjs",
    "music:covers": "node scripts/fetch-music-covers.mjs",
    "music:lastfm": "node scripts/fetch-lastfm.mjs",
    "spotify": "node --env-file-if-exists=.env scripts/fetch-spotify.mjs",
    "spotify:auth": "node --env-file-if-exists=.env scripts/spotify-auth.mjs",
    "spotify:folders": "node scripts/sync-playlist-folders.mjs",
    "spotify:dates": "node --env-file-if-exists=.env scripts/backfill-playlist-dates.mjs",
    "spotify:covers": "node --env-file-if-exists=.env scripts/fetch-playlist-covers.mjs",
    "spotify:prune": "node --env-file-if-exists=.env scripts/prune-playlists.mjs",
    "import:blogger": "node scripts/import-blogger.mjs",
    "dev": "astro dev",
    "build": "astro build && node scripts/make-sitemap.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^7.3.8"
  }
}