---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/blog.css';

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
	/** Ana sayfada tam genişlik hero için */
	wide?: boolean;
	/** Birleştirilmiş/bir sayfadan taşınmış içerik için kalıcı yönlendirme */
	redirect?: string;
}

const {
	title = 'Versucher',
	description = 'İzlediğim filmler, diziler ve okuduğum kitaplardan kişisel bir arşiv.',
	ogImage,
	redirect,
} = Astro.props;

const path = Astro.url.pathname;
const isBlog = path === '/blog' || path.startsWith('/blog/');

const fullTitle = title === 'Versucher' ? 'Versucher' : `${title} · Versucher`;
const site = Astro.site ?? new URL('https://versucher.com');
const canonical = new URL(Astro.url.pathname, site);
// Sayfaya özel görsel verilmezse varsayılan OG görseli (public/og.png) kullanılır.
const og = ogImage ? new URL(ogImage, site).href : undefined;
const ogUrl = og ?? new URL('/og.png', site).href;
---

<!doctype html>
<html lang="tr" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />

		{/* Tarayıcı arayüzü rengi: koyu varsayılan, sistem açıksa açık tema. */}
		<meta name="theme-color" content="#111113" media="(prefers-color-scheme: dark)" />
		<meta name="theme-color" content="#f4f1ea" media="(prefers-color-scheme: light)" />

		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{redirect && <meta http-equiv="refresh" content={`0;url=${redirect}`} />}
		{redirect && <meta name="robots" content="noindex" />}
		<link rel="alternate" type="application/rss+xml" title="Versucher — yazılar" href="/rss.xml" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Versucher" />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content="tr_TR" />
		<meta property="og:image" content={ogUrl} />
		{!og && <meta property="og:image:width" content="1200" />}
		{!og && <meta property="og:image:height" content="630" />}
		<meta property="og:image:alt" content={og ? fullTitle : 'Versucher'} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogUrl} />

		{/* Fontlar yerelden sunulur (public/fonts + src/styles/fonts.css).
		    İlk boyamada görünen iki aile (başlık + gövde) önden yüklenir.
		    Türkçe karakterler (ğ ş ı İ) latin-ext dosyasında olduğu için
		    her iki alt küme de önden yüklenir. */}
		<link
			rel="preload"
			href="/fonts/manufacturing-consent-normal-latin.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/manufacturing-consent-normal-latin-ext.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/alegreya-normal-latin.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/alegreya-normal-latin-ext.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>

		<script is:inline>
			// Tema, ilk boyamadan önce uygulanır (flash yok).
			// Kayıtlı seçim yoksa sistem tercihine uyulur.
			(function () {
				try {
					var t = localStorage.getItem('theme');
					if (t !== 'light' && t !== 'dark') {
						t =
							window.matchMedia &&
							window.matchMedia('(prefers-color-scheme: light)').matches
								? 'light'
								: 'dark';
					}
					document.documentElement.setAttribute('data-theme', t);
				} catch (e) {}
			})();
		</script>
	</head>
	<body class:list={[{ 'is-blog': isBlog }]}>
		<a href="#main" class="skip">İçeriğe geç</a>
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	.skip {
		position: absolute;
		left: -9999px;
		top: 0;
		z-index: 100;
		background: var(--accent);
		color: var(--accent-contrast);
		padding: 0.6rem 1rem;
		border-radius: 0 0 var(--radius-sm) 0;
	}
	.skip:focus {
		left: 0;
	}
	main {
		min-height: 60vh;
	}
</style>
