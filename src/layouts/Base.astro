---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/blog.css';

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
	/** Ana sayfada tam genişlik hero için */
	wide?: boolean;
}

const {
	title = 'Versucher',
	description = 'İzlediğim filmler, diziler ve okuduğum kitaplardan kişisel bir arşiv.',
	ogImage,
} = Astro.props;

const path = Astro.url.pathname;
const isBlog = path === '/blog' || path.startsWith('/blog/');

const fullTitle = title === 'Versucher' ? 'Versucher — kişisel arşiv' : `${title} · Versucher`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://versucher.com');
const og = ogImage ? new URL(ogImage, Astro.site ?? 'https://versucher.com').href : undefined;
---

<!doctype html>
<html lang="tr" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:locale" content="tr_TR" />
		{og && <meta property="og:image" content={og} />}
		<meta name="twitter:card" content={og ? 'summary_large_image' : 'summary'} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Manufacturing+Consent&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Manrope:wght@300;400;500&family=Montserrat:wght@400;500;600;700&family=Cardo:ital,wght@0,400;0,700;1,400&family=Alegreya:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
		/>

		<script is:inline>
			// Tema, ilk boyamadan önce uygulanır (flash yok).
			// Kayıtlı seçim yoksa sistem tercihine uyulur.
			(function () {
				try {
					var t = localStorage.getItem('theme');
					if (t !== 'light' && t !== 'dark') {
						t =
							window.matchMedia &&
							window.matchMedia('(prefers-color-scheme: light)').matches
								? 'light'
								: 'dark';
					}
					document.documentElement.setAttribute('data-theme', t);
				} catch (e) {}
			})();
		</script>
	</head>
	<body class:list={[{ 'is-blog': isBlog }]}>
		<a href="#main" class="skip">İçeriğe geç</a>
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	.skip {
		position: absolute;
		left: -9999px;
		top: 0;
		z-index: 100;
		background: var(--accent);
		color: var(--accent-contrast);
		padding: 0.6rem 1rem;
		border-radius: 0 0 var(--radius-sm) 0;
	}
	.skip:focus {
		left: 0;
	}
	main {
		min-height: 60vh;
	}
</style>
