---
import Base from '../layouts/Base.astro';
import PlaylistBrowser from '../components/PlaylistBrowser.astro';
import { folderChips, playlistsInFolder, listedPlaylists } from '../lib/playlists';
import { spotifyPlaylists } from '../lib/playlists';
import { formatDate } from '../lib/format';

/**
 * Playlistler ana sayfası. Statik çıktı: sorgu okunamaz, bu yüzden klasör
 * başına ayrı sayfa üretilir (`/playlist/k/<id>`, `/playlist/hepsi`). Burada
 * yalnızca varsayılan (ilk) klasörün kartları render edilir; sayfa hafif kalır.
 */
const chips = folderChips();
const folder = chips[0]?.id ?? '__all';
const items = playlistsInFolder(folder);
const total = listedPlaylists().length;
const spotifyFetchedAt = spotifyPlaylists.fetchedAt;
const hasData = total > 0;
---

<Base title="Playlistler" description={`Public Spotify playlistlerim: ${total} liste.`}>
	<div class="container section">
		<header class="section-head">
			<div>
				<p class="eyebrow">Müzik</p>
				<h1>Playlistler</h1>
				<p class="lede">
					{hasData ? `${total} public playlist` : 'Henüz veri yok — npm run spotify çalıştır.'}
				</p>
			</div>
			{hasData && spotifyFetchedAt && (
				<p class="muted">Güncellenme: {formatDate(new Date(spotifyFetchedAt))}</p>
			)}
		</header>

		{!hasData && (
			<section class="panel">
				<h2>Kurulum</h2>
				<ol>
					<li>
						developer.spotify.com/dashboard → Create app (Redirect URI:{' '}
						<code>http://127.0.0.1:8888/callback</code>)
					</li>
					<li>
						<code>.env</code> içine <code>SPOTIFY_CLIENT_ID</code>, <code>SPOTIFY_CLIENT_SECRET</code>
					</li>
					<li>
						<code>npm run spotify:auth</code> → tarayıcıda onayla
					</li>
					<li><code>npm run spotify</code></li>
				</ol>
			</section>
		)}

		{hasData && <PlaylistBrowser folder={folder} items={items} />}
	</div>
</Base>
