---
import Base from '../layouts/Base.astro';
import MusicCover from '../components/MusicCover.astro';
import { listedPlaylists, folderChips, getPlaylistFolderIds, spotifyPlaylists } from '../lib/playlists';
import { durationShort } from '../lib/music';
import { formatDate } from '../lib/format';

const playlists = listedPlaylists();
const hasData = playlists.length > 0;
// Oluşturulma tarihi (en eski şarkı ekleme anından); yoksa 0 → sıralamada sonda.
const createdMs = (iso?: string | null) => (iso ? Date.parse(iso) || 0 : 0);

// Klasör çipleri (başlık + çipler bloğu). Her playlist doğrudan tek bir
// whitelist klasöre aittir; çipler düz ve eşittir.
const chips = folderChips();
const chipCount = new Map(chips.map((c) => [c.id, 0]));
for (const p of playlists) {
	for (const id of getPlaylistFolderIds(p.id)) {
		if (chipCount.has(id)) chipCount.set(id, chipCount.get(id)! + 1);
	}
}
const folderName = new Map(chips.map((c) => [c.id, c.name]));
const spotifyFetchedAt = spotifyPlaylists.fetchedAt;

// Varsayılan klasör sunucuda uygulanır: kullanıcı sorgusuz açtığında diğer
// kartlar zaten gizli gelir, süzgeç "sonradan" uygulanmış gibi görünmez.
const defaultFolder = chips[0]?.id ?? '__all';
---

<Base title="Playlistler" description="Public Spotify playlistlerim.">
	<div class="container section">
		<header class="section-head">
			<div>
				<p class="eyebrow">Müzik</p>
				<h1>Playlistler</h1>
				<p class="lede">
					{hasData ? `${playlists.length} public playlist` : "Henüz veri yok — npm run spotify çalıştır."}
				</p>
			</div>
			{hasData && spotifyFetchedAt && (
				<p class="muted">Güncellenme: {formatDate(new Date(spotifyFetchedAt))}</p>
			)}
		</header>

		{
			!hasData && (
				<section class="panel">
					<h2>Kurulum</h2>
					<ol>
						<li>
							developer.spotify.com/dashboard → Create app (Redirect URI:{' '}
							<code>http://127.0.0.1:8888/callback</code>)
						</li>
						<li>
							<code>.env</code> içine <code>SPOTIFY_CLIENT_ID</code>, <code>SPOTIFY_CLIENT_SECRET</code>
						</li>
						<li>
							<code>npm run spotify:auth</code> → tarayıcıda onayla
						</li>
						<li>
							<code>npm run spotify</code>
						</li>
					</ol>
				</section>
			)
		}

		{
			hasData && chips.length > 0 && (
				<section class="pl-folders" aria-label="Klasörler">
					<div class="pl-folders-head">
						<h2 class="pl-folders-title">Klasörler</h2>
						<select class="pl-sort" data-pl-sort aria-label="Sıralama">
							<option value="az">A → Z</option>
							<option value="za">Z → A</option>
							<option value="yeni">Yeniden eskiye</option>
							<option value="eski">Eskiden yeniye</option>
						</select>
					</div>
					<div class="fchips">
						<button
							class:list={['fchip', { 'is-on': defaultFolder === '__all' }]}
							type="button"
							data-folder="__all"
						>
							Tümü <span class="n">{playlists.length}</span>
						</button>
						{chips.map((c) => (
							<button
								class:list={['fchip', { 'is-on': c.id === defaultFolder }]}
								type="button"
								data-folder={c.id}
							>
								{c.name} <span class="n">{chipCount.get(c.id) ?? 0}</span>
							</button>
						))}
					</div>
				</section>
			)
		}

		{
			hasData && (
				<ul class="grid pl-list" data-pl-grid>
					{playlists.map((pl) => {
						const folders = getPlaylistFolderIds(pl.id);
						return (
							<li
								class="card pl"
								data-folders={folders.join(' ')}
								data-name={pl.name.trim().toLocaleLowerCase('tr')}
								data-created={createdMs(pl.createdAt)}
								hidden={defaultFolder !== '__all' && !folders.includes(defaultFolder)}
							>
								<a class="pl-cover" href={`/playlist/${pl.id}`} aria-label={pl.name}>
									<MusicCover src={pl.cover ?? undefined} alt="" name={pl.name} />
								</a>
								<div class="pl-body">
									<h3 class="t">
										<a href={`/playlist/${pl.id}`}>{pl.name.trim() || '(isimsiz)'}</a>
									</h3>
									<p class="s muted">
										{pl.trackCount} şarkı · {pl.artistCount} artist
										{pl.name === '𝔰𝔢𝔯𝔭𝔢𝔫𝔱 𝔠𝔲𝔩𝔱𝔲𝔯𝔢 ⛧' && pl.durationMs > 0 ? ` · ${durationShort(pl.durationMs)}` : ''}
									</p>
									<p class="pl-folder-tag">
										{folders
											.map((id) => folderName.get(id))
											.filter(Boolean)
											.join(' · ')}
									</p>
									<div class="pl-actions">
										<a class="btn btn--accent" href={`/playlist/${pl.id}`}>
											Detay
										</a>
										<a class="btn" href={pl.url} target="_blank" rel="noopener">
											Spotify
										</a>
									</div>
								</div>
							</li>
						);
					})}
				</ul>
			)
		}
	</div>
</Base>

<script>
	const grid = document.querySelector<HTMLElement>('[data-pl-grid]');
	const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.fchip'));
	const sortSel = document.querySelector<HTMLSelectElement>('[data-pl-sort]');
	if (grid && chips.length) {
		const cards = Array.from(grid.children) as HTMLElement[];
		const defaultFolder = chips.find((c) => c.dataset.folder !== '__all')?.dataset.folder ?? '__all';

		// Sıralayıcılar: A-Z, Z-A, yeniden eskiye, eskiden yeniye.
		// Tarihi bilinmeyenler her zaman sonda kalır.
		const bySort = (mode: string) => (a: HTMLElement, b: HTMLElement) => {
			const an = a.dataset.name || '';
			const bn = b.dataset.name || '';
			if (mode === 'az') return an.localeCompare(bn, 'tr');
			if (mode === 'za') return bn.localeCompare(an, 'tr');
			const ac = Number(a.dataset.created || 0);
			const bc = Number(b.dataset.created || 0);
			if (!ac && !bc) return an.localeCompare(bn, 'tr');
			if (!ac) return 1;
			if (!bc) return -1;
			return mode === 'yeni' ? bc - ac : ac - bc;
		};

		const params = new URLSearchParams(location.search);
		let folder = params.get('k') || defaultFolder;
		let sort = params.get('s') || 'az';

		const apply = () => {
			const all = folder === '__all';
			const visible = cards.filter((c) => all || (c.dataset.folders || '').split(/\s+/).includes(folder));
			visible.sort(bySort(sort));
			for (const c of cards) c.hidden = true;
			for (const c of visible) {
				c.hidden = false;
				grid.appendChild(c);
			}
			for (const c of chips) c.classList.toggle('is-on', c.dataset.folder === folder);
			if (sortSel) sortSel.value = sort;
		};

		const syncUrl = () => {
			const url = new URL(location.href);
			if (folder === defaultFolder) url.searchParams.delete('k');
			else url.searchParams.set('k', folder);
			if (sort === 'az') url.searchParams.delete('s');
			else url.searchParams.set('s', sort);
			history.replaceState(null, '', url);
		};

		apply();

		for (const c of chips) {
			c.addEventListener('click', () => {
				folder = c.dataset.folder ?? '__all';
				apply();
				syncUrl();
			});
		}
		sortSel?.addEventListener('change', () => {
			sort = sortSel.value;
			apply();
			syncUrl();
		});
	}
</script>

<style>
	.pl-folders {
		margin: 0 0 1.4rem;
	}
	.pl-folders-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 0.75rem;
		flex-wrap: wrap;
		margin: 0 0 0.6rem;
	}
	.pl-folders-title {
		margin: 0;
		font-family: var(--font-ui);
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--text-faint);
	}
	.pl-sort {
		flex-shrink: 0;
		max-width: 100%;
		font-family: var(--font-ui);
		font-size: 0.8rem;
		padding: 0.3rem 0.5rem;
		border: 1px solid var(--border);
		border-radius: 8px;
		background: var(--surface-2);
		color: var(--text);
		cursor: pointer;
	}
	.fchips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
	}
	.fchip {
		font-family: var(--font-ui);
		font-size: 0.82rem;
		line-height: 1.2;
		padding: 0.34rem 0.7rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: var(--surface-2);
		color: var(--text-muted);
		cursor: pointer;
		transition:
			background 0.15s ease,
			border-color 0.15s ease,
			color 0.15s ease;
	}
	.fchip:hover {
		border-color: var(--accent);
		color: var(--text);
	}
	.fchip.is-on {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--accent-contrast);
	}
	.fchip .n {
		font-size: 0.72rem;
	}
	/* Playlist kartları: ekran genişliğine göre 6 / 3 / 2 sütun. */
	.grid.pl-list {
		grid-template-columns: repeat(6, minmax(0, 1fr));
	}
	@media (max-width: 1100px) {
		.grid.pl-list {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
	@media (max-width: 620px) {
		.grid.pl-list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	.pl {
		display: flex;
		flex-direction: column;
	}
	/* KRİTİK: yazar kuralı (display:flex) tarayıcının [hidden]{display:none}
	   kuralını ezdiği için süzgeç görselde işlemiyordu; bu bunu geri kazandırır. */
	.pl[hidden] {
		display: none !important;
	}
	.pl-cover {
		display: block;
	}
	.pl :global(.mcover) {
		border-radius: 0;
	}
	.pl-body {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding: 0.6rem 0.7rem 0.75rem;
	}
	.t {
		margin: 0;
		font-family: var(--font-card);
		font-size: 1.02rem;
		line-height: 1.25;
	}
	.t a {
		color: inherit;
		text-decoration: none;
	}
	.s {
		margin: 0;
		font-family: var(--font-meta);
		font-size: 0.8rem;
		line-height: 1.3;
	}
	.pl-folder-tag {
		margin: 0.2rem 0 0;
		font-family: var(--font-ui);
		font-size: 0.72rem;
		line-height: 1.2;
		letter-spacing: 0.02em;
		color: var(--text-faint);
	}
	.pl-actions {
		display: flex;
		gap: 0.4rem;
		margin-top: 0.5rem;
	}
	.pl-actions .btn {
		flex: 1;
		padding: 0.4rem 0.6rem;
		font-size: 0.78rem;
		text-align: center;
	}
	/* iOS, 16px altı form öğesine odaklanınca sayfayı yakınlaştırır; mobilde
	   select'i 16px tutarak bunu engelle. */
	@media (max-width: 640px) {
		.pl-sort {
			font-size: 1rem;
		}
	}
</style>
