---
import Base from '../layouts/Base.astro';
---

<Base title="Playlistler" description="Müzik playlistlerim — yakında.">
	<div class="container section narrow">
		<p class="eyebrow">Yakında</p>
		<h1>Playlistler</h1>
		<p class="lede">
			Bu bölüm şimdilik kapalı. Playlist sheet'i bağlandığında burada listelenecek:
			isim, kapak, platform, şarkı sayısı ve tarih.
		</p>
		<p><a class="btn" href="/">← Ana sayfa</a></p>
	</div>
</Base>

<style>
	.narrow {
		max-width: 640px;
	}
	.narrow h1 {
		margin-block: 0.2rem 0.6rem;
	}
</style>
