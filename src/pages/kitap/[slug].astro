---
import Base from '../../layouts/Base.astro';
import EntryDetail from '../../components/EntryDetail.astro';
import { books, type Kitap } from '../../lib/data';

export function getStaticPaths() {
	return books.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props as { entry: Kitap };
const description =
	entry.review ||
	`${entry.title}${entry.author ? ` — ${entry.author}` : ''} kitabı hakkında yorumum ve künyesi.`;
---

<Base title={entry.title} description={description} ogImage={entry.poster}>
	<EntryDetail entry={entry} />
</Base>
