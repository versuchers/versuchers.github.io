---
import Base from '../layouts/Base.astro';
---

<Base title="Sayfa bulunamadı" description="Aradığın sayfa burada değil.">
	<div class="container section notfound">
		<p class="code">404</p>
		<h1>Burada bir şey yok</h1>
		<p class="lede">Aradığın sayfa taşınmış ya da hiç var olmamış olabilir.</p>
		<p class="links">
			<a class="btn btn--accent" href="/">Ana sayfa</a>
			<a class="btn" href="/film">Filmler</a>
			<a class="btn" href="/kitap">Kitaplar</a>
		</p>
	</div>
</Base>

<style>
	.notfound {
		text-align: center;
		padding-block: clamp(3rem, 12vw, 8rem);
	}
	.code {
		font-family: var(--font-display);
		font-size: clamp(4rem, 20vw, 10rem);
		font-weight: 400;
		line-height: 0.9;
		color: var(--accent);
		margin: 0;
		opacity: 0.85;
		text-transform: lowercase;
	}
	.links {
		display: flex;
		gap: 0.6rem;
		justify-content: center;
		flex-wrap: wrap;
		margin-top: 1.5rem;
	}
</style>
