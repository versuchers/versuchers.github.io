---
import Base from '../layouts/Base.astro';
import GlobalSearch from '../components/GlobalSearch.astro';
import { allEntries } from '../lib/data';

const q = Astro.url.searchParams.get('q')?.trim() ?? '';
const tur = Astro.url.searchParams.get('tur')?.trim() ?? '';
const turLabel: Record<string, string> = { film: 'film', dizi: 'dizi', kitap: 'kitap' };

const heading = q ? `“${q}” için sonuçlar` : 'Ara';
const description = q
	? `${q} ile ilgili film, dizi ve kitap kayıtları.`
	: 'Film, dizi ve kitap arşivinde ara: kişi, tür, tema, yayınevi, şehir ve daha fazlası.';
---

<Base title={q ? `Ara: ${q}` : 'Ara'} description={description}>
	<div class="container section">
		<header class="page-head">
			<p class="eyebrow">Arşivde ara</p>
			<h1>{heading}</h1>
			<p class="lede">
				Film, dizi ve kitap birlikte aranır. Bir kişi hem kitap yazarı hem kaynak yazarsa
				her iki kayıt da burada çıkar.{tur && turLabel[tur] ? ` Şu an ${turLabel[tur]} süzülüyor.` : ''}
			</p>
		</header>
		<GlobalSearch items={allEntries} />
	</div>
</Base>

<style>
	.page-head {
		margin-bottom: 2rem;
	}
	.page-head h1 {
		margin-block: 0.2rem 0.6rem;
	}
</style>
