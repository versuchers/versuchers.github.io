---
import Base from '../../layouts/Base.astro';
import TagBrowse from '../../components/TagBrowse.astro';
import { allEntries } from '../../lib/data';
import { TAXONOMIES, TAXONOMY_BY_NS, taxonomyValues } from '../../lib/taxonomy';
import { tagSlug } from '../../lib/text';
import { artistsByCountry, countryLabels } from '../../lib/artist-info';

/**
 * Global etiket sayfası: `/sehir/istanbul`, `/tur/bilim-kurgu`…
 * Aynı etiket kitap, film ve dizide geçiyorsa hepsini birlikte listeler;
 * tür çipleriyle süzülebilir.
 */
export function getStaticPaths() {
	const map = new Map<string, { ns: string; val: string; label: string }>();
	for (const e of allEntries) {
		for (const def of TAXONOMIES) {
			for (const v of taxonomyValues(def, e)) {
				const slug = tagSlug(v);
				const key = `${def.ns}/${slug}`;
				if (!map.has(key)) map.set(key, { ns: def.ns, val: slug, label: v });
			}
		}
	}
	// Sanatçı ülkeleri: kaydı olmayan ülkeler de sayfa açar (yalnızca sanatçı listelenir).
	for (const [slug] of artistsByCountry) {
		const key = `ulke/${slug}`;
		if (!map.has(key)) {
			map.set(key, { ns: 'ulke', val: slug, label: countryLabels.get(slug) ?? slug });
		}
	}
	return [...map.values()].map((p) => ({
		params: { ns: p.ns, val: p.val },
		props: { label: p.label },
	}));
}

const ns = String(Astro.params.ns ?? '');
const val = String(Astro.params.val ?? '');
const { label } = Astro.props as { label: string };
const def = TAXONOMY_BY_NS.get(ns);

const items = def
	? allEntries.filter((e) => taxonomyValues(def, e).some((v) => tagSlug(v) === val))
	: [];

// Ülke sayfaları sanatçıları da listeler (kitap/film/dizi ile aynı etiket havuzu).
const countryArtists = ns === 'ulke' ? (artistsByCountry.get(val) ?? []) : [];

// Türkçe bulunma hâli eki: İstanbul'da, İzmir'de, Zonguldak'ta, Paris'te…
function locative(word: string): string {
	const w = word.trim().toLocaleLowerCase('tr');
	const vowels = 'aeıioöuü';
	let lastVowel = '';
	for (let i = w.length - 1; i >= 0; i--) {
		if (vowels.includes(w[i])) {
			lastVowel = w[i];
			break;
		}
	}
	const suffixVowel = 'aıou'.includes(lastVowel) ? 'a' : 'e';
	const lastChar = w[w.length - 1] ?? '';
	const d = 'fstkçşhp'.includes(lastChar) ? 't' : 'd';
	return `'${d}${suffixVowel}`;
}

const isSehir = ns === 'sehir';
const title = isSehir
	? `${label}${locative(label)} okunanlar ve izlenenler`
	: def
		? `${label} – ${def.label}`
		: label;
const desc = countryArtists.length
	? `${items.length} kayıt, ${countryArtists.length} sanatçı`
	: `${items.length} kayıt`;
---

<Base title={title} description={desc}>
	<main class="container" style="padding:1.5rem 1rem 3rem">
		<header class="tag-head">
			<p class="eyebrow">{def?.label ?? 'Etiket'}</p>
			<h1>{title}</h1>
		</header>
		<TagBrowse items={items} artists={countryArtists} />
	</main>
</Base>

<style>
	.tag-head {
		margin-bottom: 1.25rem;
	}
	.tag-head h1 {
		margin: 0.15rem 0 0;
	}
</style>
