---
import Base from '../layouts/Base.astro';
import Rail from '../components/Rail.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../lib/format';
import { titleCaseTr } from '../lib/text';
import { latestWatched, latestRead, latestReviewed } from '../lib/data';

const watched = latestWatched(6);
const read = latestRead(6);
const reviewed = latestReviewed(6);

// Şifreli yazılar anasayfada gösterilmez: içeriklerinin ilk satırları görünür ve kilitli hâli çirkin durur.
const posts = (await getCollection('blog', ({ data }) => !data.draft && !data.encrypted))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 6);
---

<Base>
	<h1 class="visually-hidden">Versucher — kişisel arşiv</h1>

	<Rail items={read} title="Son okuduklarım" moreHref="/kitap" moreLabel="Tüm kitaplar" />

	<Rail items={watched} title="Son izlediklerim" moreHref="/film" moreLabel="Tüm filmler" />

	<Rail items={reviewed} title="Son yorumladıklarım" moreHref="/film" moreLabel="Gözat" layout="rows" />

	{posts.length > 0 && (
		<section class="section">
			<div class="container">
				<div class="panel">
					<div class="section-head">
						<h2>Son yazılar</h2>
						<a class="more" href="/blog">Blog →</a>
					</div>
					<ul class="posts">
						{posts.map((post) => (
							<li>
								<a class="post" href={`/blog/${post.id}`}>
									<time datetime={post.data.pubDate.toISOString()}>
										{formatDate(post.data.pubDate)}
									</time>
									<h3>{titleCaseTr(post.data.title)}</h3>
									{post.data.description && <p class="muted">{post.data.description}</p>}
								</a>
							</li>
						))}
					</ul>
				</div>
			</div>
		</section>
	)}
</Base>

<style>
	.posts {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 1rem;
	}
	.post {
		display: block;
		height: 100%;
		padding: 1.1rem 1.25rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
		transition: border-color var(--dur) var(--ease), transform var(--dur) var(--ease);
	}
	.post:hover {
		border-color: var(--accent);
		transform: translateY(-2px);
	}
	.post h3 {
		font-family: var(--font-card);
		margin: 0.2rem 0 0.4rem;
		font-size: 1.15rem;
		font-weight: 700;
	}
	.post time {
		font-size: 0.8rem;
		color: var(--text-faint);
	}
	.post p {
		margin: 0;
		font-size: 1.26rem;
	}
</style>
