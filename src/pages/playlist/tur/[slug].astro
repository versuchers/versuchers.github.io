---
import Base from '../../../layouts/Base.astro';
import MusicCover from '../../../components/MusicCover.astro';
import { genrePages, type GenrePage } from '../../../lib/playlist-genres';
import { artistsByGenre } from '../../../lib/artist-info';
import { cover, integer, type Artist } from '../../../lib/music';

export function getStaticPaths() {
	return genrePages().map((page) => ({
		params: { slug: page.slug },
		props: { page, artists: artistsByGenre.get(page.slug) ?? [] },
	}));
}

const { page, artists } = Astro.props as {
	page: GenrePage;
	artists: Artist[];
};

const hasArtists = artists.length > 0;
// Hiç playlist yoksa (yalnızca sanatçı eşleşiyorsa) açılışta sanatçılar görünür.
const artistsOnly = hasArtists && page.rows.length === 0;
const total = page.rows.length + artists.length;
---

<Base
	title={`${page.name} — Playlist türü`}
	description={`${page.name} türünde ${page.rows.length} playlist, ${artists.length} sanatçı.`}
>
	<div class="container section">
		<nav class="crumbs"><a href="/playlist">← Playlistler</a></nav>

		<header class="page-head">
			<p class="eyebrow">Playlist türü</p>
			<h1>{page.name}</h1>
			<p class="lede">{total} kayıt</p>
		</header>

		<div data-pl-genre>
			<section class="chip-bar" aria-label="Türe göre süz">
				<div class="fchips" role="group" aria-label="Türe göre süz">
					<button
						type="button"
						class:list={['fchip', { 'is-on': !artistsOnly }]}
						data-type=""
						aria-pressed={artistsOnly ? 'false' : 'true'}
					>
						Tümü <span class="n">{total}</span>
					</button>
					<button
						type="button"
						class="fchip"
						data-type="playlist"
						aria-pressed="false"
					>
						Playlist <span class="n">{page.rows.length}</span>
					</button>
					{hasArtists && (
						<button
							type="button"
							class:list={['fchip', { 'is-on': artistsOnly }]}
							data-type="artist"
							aria-pressed={artistsOnly ? 'true' : 'false'}
						>
							Artist <span class="n">{artists.length}</span>
						</button>
					)}
				</div>
			</section>

			<div class="panel">
				<ol class="pl-list" data-pl-list>
					{page.rows.map((row) => (
						<li class="pl-item" data-kind="playlist">
							<div class="pl-line">
								<a class="pl-name" href={`/playlist/${row.id}`}>{row.name}</a>
								<span class="pl-count muted">{integer(row.count)} şarkı</span>
							</div>
							{row.folders.length > 0 && (
								<p class="pl-folders muted">{row.folders.join(' · ')}</p>
							)}
						</li>
					))}
				</ol>

				<ul class="grid artist-grid" data-artist-list hidden={!artistsOnly}>
					{artists.map((a) => (
						<li class="acard">
							<a class="acard-link" href={`/muzik/sanatci/${a.slug}`}>
								<span class="acard-cover">
									<MusicCover src={cover('artist', a.slug)} alt="" name={a.name} round />
								</span>
								<span class="acard-name">{a.name}</span>
							</a>
						</li>
					))}
				</ul>
			</div>
		</div>
	</div>
</Base>

<script>
	document.querySelectorAll<HTMLElement>('[data-pl-genre]').forEach((root) => {
		const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('.fchip'));
		const plItems = Array.from(root.querySelectorAll<HTMLElement>('[data-kind="playlist"]'));
		const plList = root.querySelector<HTMLElement>('[data-pl-list]')!;
		const artistList = root.querySelector<HTMLElement>('[data-artist-list]');
		const hasArtists = !!artistList;

		// Yalnızca sanatçısı olan türlerde açılış görünümü sanatçı listesidir.
		let mode: 'all' | 'playlist' | 'artist' =
			hasArtists && plItems.length === 0 ? 'artist' : 'all';

		function apply() {
			const showPl = mode !== 'artist';
			const showArtists = mode === 'artist';
			for (const el of plItems) el.hidden = !showPl;
			if (plList) plList.hidden = !showPl;
			if (artistList) artistList.hidden = !showArtists;
			for (const chip of chips) {
				const type = chip.dataset.type ?? '';
				const on = type === '' ? mode === 'all' : type === mode;
				chip.classList.toggle('is-on', on);
				chip.setAttribute('aria-pressed', on ? 'true' : 'false');
			}
		}

		for (const chip of chips) {
			chip.addEventListener('click', () => {
				const t = chip.dataset.type ?? '';
				mode = t === 'artist' ? 'artist' : t === 'playlist' ? 'playlist' : 'all';
				apply();
			});
		}

		apply();
	});
</script>

<style>
	.crumbs {
		margin-bottom: 1rem;
		font-family: var(--font-head);
		font-size: 0.85rem;
	}

	/* Çipler, /playlist sayfasındaki "seçili alan 1" (.fchips) ile aynı tasarım. */
	.chip-bar {
		margin: 0 0 1.4rem;
	}
	.fchips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
	}
	.fchip {
		display: inline-flex;
		align-items: center;
		gap: 0.35em;
		margin: 0;
		padding: 0.24em 0.7em;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		background: var(--surface-2);
		color: var(--text-muted);
		font-family: var(--font-display);
		font-size: 18px;
		line-height: 1.5;
		text-transform: lowercase;
		white-space: nowrap;
		cursor: pointer;
		transition:
			color var(--dur) var(--ease),
			border-color var(--dur) var(--ease),
			background-color var(--dur) var(--ease);
	}
	.fchip:hover {
		color: var(--link-hover);
		border-color: var(--link-hover);
		background: var(--accent-soft);
	}
	.fchip:focus-visible {
		outline: var(--ring) solid var(--link-hover);
		outline-offset: 2px;
	}
	.fchip.is-on {
		color: var(--text);
		border-color: var(--accent);
		background: var(--accent-soft);
	}
	.fchip.is-on:hover {
		color: var(--text);
		border-color: var(--link-hover);
		background: var(--accent-soft);
	}
	.fchip .n {
		color: var(--text-faint);
		font-size: 0.9em;
	}
	.fchip.is-on .n {
		color: var(--text-muted);
	}

	/* Liste kutusu: /playlist kart ızgarasıyla aynı zemin ve çerçeve dili. */
	.panel {
		background: var(--surface);
		border-radius: 14px;
		box-shadow: var(--shadow);
		padding: clamp(1.15rem, 2.6vw, 1.85rem) clamp(1.15rem, 3vw, 2.25rem)
			clamp(1.4rem, 3vw, 2.25rem);
	}

	.pl-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
	}

	.pl-item {
		border-bottom: 1px solid var(--border);
		padding-bottom: 0.9rem;
	}
	.pl-item:last-child {
		border-bottom: 0;
		padding-bottom: 0;
	}
	.pl-item[hidden] {
		display: none !important;
	}

	.pl-line {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}

	.pl-name {
		font-weight: 600;
		color: var(--text);
		text-decoration: none;
	}

	.pl-name:hover {
		color: var(--link-hover);
		text-decoration: underline;
	}

	.pl-count {
		font-family: var(--font-ui);
		font-size: 0.8rem;
		white-space: nowrap;
	}

	.pl-folders {
		margin: 0.25rem 0 0;
		font-family: var(--font-ui);
		font-size: 0.7rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.pl-item .pl-folders {
		margin-top: 0.25rem;
	}

	/* Sanatçı listesi: yuvarlak kapak + ad, ekran genişliğine göre sütun. */
	.artist-grid {
		grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
		gap: 1rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.artist-grid[hidden] {
		display: none !important;
	}
	.acard-link {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.55rem;
		text-align: center;
		text-decoration: none;
		color: inherit;
	}
	.acard-cover {
		display: block;
		width: 100%;
		max-width: 150px;
	}
	.acard-name {
		font-family: var(--font-card);
		font-size: 15px;
		line-height: 1.3;
		color: var(--text);
	}
	.acard-link:hover .acard-name {
		color: var(--link-hover);
	}
	@media (max-width: 640px) {
		.artist-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0.75rem;
		}
	}
</style>
