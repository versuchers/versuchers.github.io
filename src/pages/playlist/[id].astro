---
import Base from '../../layouts/Base.astro';
import MusicCover from '../../components/MusicCover.astro';
import { durationShort } from '../../lib/music';
import {
	getPlaylistById,
	listedPlaylists,
} from '../../lib/playlists';
import { artistHref, trackHref } from '../../lib/playlist-xref';
import { keptGenres, genreHref } from '../../lib/playlist-genres';

export function getStaticPaths() {
	return listedPlaylists().map((p) => ({ params: { id: p.id } }));
}

const { id } = Astro.params;
const pl = getPlaylistById(id);

if (!pl) {
	throw new Error(`Playlist bulunamadı: ${id}`);
}

const kept = keptGenres(pl);

const description = pl.description ? pl.description.replace(/<[^>]*>/g, '').trim() : '';
---

<Base title={pl.name} description={`Spotify playlist: ${pl.name}`}>
	<div class="container section">
		<nav class="crumbs"><a href="/playlist">← Playlistler</a></nav>

		<header class="pl-head">
			<div class="pl-cover">
				<MusicCover src={pl.cover ?? undefined} alt="" name={pl.name} eager />
			</div>
			<div class="pl-info">
				<p class="eyebrow">Playlist</p>
				<h1>
					{pl.name.trim() || '(isimsiz)'}
					<a class="pl-spotify" href={pl.url} target="_blank" rel="noopener" aria-label="Spotify'da aç" title="Spotify'da aç">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>
					</a>
				</h1>
				{description && <p class="lede">{description}</p>}
				<p class="muted">
					{pl.trackCount} şarkı · {pl.artistCount} artist · {pl.albumCount} albüm
					{pl.name === 'Serpent Culture' && pl.durationMs > 0 ? ` · ${durationShort(pl.durationMs)}` : ''}
				</p>
			</div>
		</header>

		<div class="two">
			<section class="panel">
				<h2>Türler</h2>
				{pl.genres.length > 0 && kept.length > 0 ? (
					<ul class="genres">
						{kept.map((g) => (
							<li class="gr">
								<a class="gr-name" href={genreHref(g.name)}>{g.name}</a>
								<span class="gr-count muted">{g.count}</span>
							</li>
						))}
					</ul>
				) : pl.genres.length > 0 ? (
					<p class="muted">
						Listelenen tür yok (siyah liste/eşik süzgeci uygulandı).
					</p>
				) : (
					<p class="muted">
						Tür henüz yok. <code>npm run spotify -- --genres-only</code> ile Last.fm'den doldurulur.
					</p>
				)}
			</section>

			<section class="panel">
				<h2>Tüm şarkılar</h2>
				<ol class="tracks">
					{pl.tracks.map((t) => {
						const songHref = trackHref(t);
						return (
							<li class="track">
								{songHref ? (
									<a class="tr-name" href={songHref}>{t.name}</a>
								) : (
									<span class="tr-name">{t.name}</span>
								)}
								<span class="tr-sep muted" aria-hidden="true">·</span>
								<span class="tr-art muted">
									{t.artists.map((x, i) => {
										const href = artistHref(x.name);
										return (
											<>
												{i > 0 && ', '}
												{href ? <a href={href}>{x.name}</a> : x.name}
											</>
										);
									})}
								</span>
							</li>
						);
					})}
				</ol>
			</section>
		</div>
	</div>
</Base>

<style>
	.crumbs {
		margin-bottom: 1rem;
		font-family: var(--font-ui);
		font-size: 0.85rem;
	}
	/* Tür listesi: şarkı listesiyle aynı satır düzeni; taşarsa kendi içinde kayar. */
	.genres {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		max-height: 32rem;
		overflow: auto;
	}
	.gr {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 0.6rem;
		padding-bottom: 0.3rem;
		border-bottom: 1px solid var(--border);
	}
	.gr-name {
		font-size: 17px;
		color: inherit;
	}
	.gr-name:hover {
		color: var(--link-hover);
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.gr-count {
		font-family: var(--font-meta);
		font-size: 0.78rem;
		font-variant-numeric: tabular-nums;
		color: var(--text-faint);
	}
	.pl-head {
		display: grid;
		grid-template-columns: minmax(140px, 220px) 1fr;
		gap: 1.2rem;
		align-items: start;
		margin-bottom: 1.6rem;
		background: var(--surface);
		border-radius: 14px;
		box-shadow: var(--shadow);
		padding: clamp(1.15rem, 2.6vw, 1.85rem) clamp(1.15rem, 3vw, 2.25rem)
			clamp(1.4rem, 3vw, 2.25rem);
	}
	.pl-cover :global(.mcover) {
		border: 1px solid var(--border-strong);
		border-radius: var(--radius);
		box-shadow: var(--shadow);
	}
	.pl-info h1 {
		margin: 0.15rem 0 0.5rem;
	}
	.pl-spotify {
		display: inline-flex;
		vertical-align: -0.08em;
		margin-left: 0.4rem;
		color: var(--text-muted);
		transition: color var(--dur) var(--ease);
	}
	.pl-spotify:hover {
		color: var(--link-hover);
	}
	.pl-spotify svg {
		width: 0.62em;
		height: 0.62em;
		fill: currentColor;
	}
	.two {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--gap);
	}
	.tracks {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		max-height: 32rem;
		overflow: auto;
	}
	.track {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.15rem 0.4rem;
		padding-bottom: 0.3rem;
		border-bottom: 1px solid var(--border);
	}
	.tr-name {
		font-size: 17px;
	}
	.tr-name:where(a) {
		color: inherit;
	}
	.tr-name:where(a):hover {
		color: var(--link-hover);
	}
	.tr-sep {
		font-size: 17px;
	}
	.tr-art {
		font-family: var(--font-card);
		font-size: 17px;
	}
	@media (max-width: 640px) {
		.pl-head,
		.two {
			grid-template-columns: 1fr;
		}
		.pl-cover {
			max-width: 220px;
		}
	}
</style>
