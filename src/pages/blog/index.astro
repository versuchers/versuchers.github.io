---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Base title="Blog" description="Yazdığım yazılar: notlar, denemeler, listeler.">
	<div class="section blog-feed">
		<header class="page-head">
			<p class="eyebrow">Yazılar</p>
			<h1>Blog</h1>
			<p class="lede">Notlar, denemeler, listeler. Kişisel arşivin konuşan kısmı.</p>
		</header>

		{
			posts.length === 0 ? (
				<p class="muted">Henüz yazı yok.</p>
			) : (
				<ul class="posts">
					{posts.map((post) => (
						<PostCard post={post} />
					))}
				</ul>
			)
		}
	</div>
</Base>
