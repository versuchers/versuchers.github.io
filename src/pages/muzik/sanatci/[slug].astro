---
import Base from '../../../layouts/Base.astro';
import MusicDetail from '../../../components/MusicDetail.astro';
import MusicRows from '../../../components/MusicRows.astro';
import {
	artists,
	stats,
	cover,
	integer,
	durationText,
	musicDate,
	hasTrack,
	hasAlbum,
	type Artist,
} from '../../../lib/music';
import { artistPlaylists } from '../../../lib/playlist-xref';
import { artistExtra, artistCountryHref } from '../../../lib/artist-info';
import { artistRank } from '../../../lib/artist-rank';

export function getStaticPaths() {
	return artists.map((a) => ({ params: { slug: a.slug }, props: { a } }));
}

const { a } = Astro.props as { a: Artist };
const years = stats.years.map((y) => String(y.year));

const trackRows = a.topTracks.map((t) => ({
	title: t.name,
	sub: t.album,
	href: hasTrack(t.slug) ? `/muzik/sarki/${t.slug}` : null,
	src: t.slug ? cover('track', t.slug) : undefined,
	plays: t.plays,
}));

const albumRows = a.topAlbums.map((al) => ({
	title: al.name,
	href: hasAlbum(al.slug) ? `/muzik/album/${al.slug}` : null,
	src: al.slug ? cover('album', al.slug) : undefined,
	plays: al.plays,
}));

const description = `${a.name} — ${integer(a.plays)} çalma, ${durationText(a.ms)} dinleme.`;

// Public playlistlerdeki varlığı (kural: yalnızca sayfası olan sanatçılar eşleşir).
const plData = artistPlaylists(a.slug);

// Tür satırı: ilk 3 tür; siyah liste + çıplak "metal" etiketi elenir, her tür
// kendi etiket sayfasına bağlanır.
const artistInfo = artistExtra(a.slug);
// Ülke, kitap/film/dizi kayıtlarıyla ortak etiket sayfasına (/ulke/<slug>) bağlanır.
const countryHref = artistCountryHref(a.slug);

// Tüm zamanlar çalma sırası: başlıkta "#N" olarak gösterilir.
const rank = artistRank.get(a.slug);
---

<Base title={`${a.name} — Müzik`} description={description} ogImage={cover('artist', a.slug)}>
	<MusicDetail
		kindLabel="Sanatçı"
		kindPlural="Sanatçılar"
		kindHref="/muzik/sanatcilar"
		title={a.name}
		coverSrc={cover('artist', a.slug)}
		round
		artistInfo={{ ...artistInfo, countryHref }}
		rank={rank}
		stats={[
			{ k: 'Çalma', v: integer(a.plays) },
			{ k: 'Dinleme', v: durationText(a.ms) },
			{ k: 'Şarkı', v: integer(a.trackCount) },
			{ k: 'Albüm', v: integer(a.albumCount) },
			{ k: 'İlk dinleme', v: musicDate(a.first) },
			{ k: 'Son dinleme', v: musicDate(a.last) },
		]}
		values={a.byYear}
		labels={years}
	>
		{trackRows.length > 0 && (
			<section class="block">
				<div class="section-head"><h2>En çok dinlenen şarkılar</h2></div>
				<MusicRows rows={trackRows} />
			</section>
		)}

		{albumRows.length > 0 && (
			<section class="block">
				<div class="section-head"><h2>Albümler</h2></div>
				<MusicRows rows={albumRows} />
			</section>
		)}

		{plData.rows.length > 0 && (
			<section class="block">
				<div class="section-head"><h2>Playlistlerimde</h2></div>
				<p class="pl-sum muted">
					{integer(plData.songs)} şarkı · {integer(plData.playlists)} playlist
				</p>
				<ol class="pl-list">
					{plData.rows.map((p) => (
						<li class="pl-item">
							<div class="pl-line">
								<a class="pl-name" href={`/playlist/${p.id}`}>{p.name}</a>
								<span class="pl-count muted">{integer(p.count)} şarkı</span>
							</div>
							<p class="pl-tracks muted">
								{p.trackNames.join(', ')}
								{p.extra > 0 && <> +{p.extra}</>}
							</p>
						</li>
					))}
				</ol>
			</section>
		)}
	</MusicDetail>
</Base>

<style>
	.block {
		margin-top: clamp(2rem, 5vw, 3rem);
	}
	.pl-sum {
		margin: 0 0 0.7rem;
		font-family: var(--font-meta);
		font-size: 0.85rem;
	}
	.pl-list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--border);
	}
	.pl-item {
		padding: 0.55rem 0.2rem;
		border-bottom: 1px solid var(--border);
	}
	.pl-line {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.2rem 0.8rem;
	}
	.pl-name {
		font-family: var(--font-card);
		font-size: 1.05rem;
		color: inherit;
	}
	.pl-name:hover {
		color: var(--link-hover);
	}
	.pl-count {
		font-family: var(--font-meta);
		font-size: 0.8rem;
		white-space: nowrap;
	}
	.pl-tracks {
		margin: 0.15rem 0 0;
		font-family: var(--font-meta);
		font-size: 0.82rem;
		line-height: 1.35;
	}
</style>
