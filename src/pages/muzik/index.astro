---
import Base from '../../layouts/Base.astro';
import MusicCard from '../../components/MusicCard.astro';
import MusicCover from '../../components/MusicCover.astro';
import {
	stats,
	albums,
	tracks,
	genres,
	cover,
	integer,
	dayLabel,
	musicDate,
	WEEKDAYS_TR,
} from '../../lib/music';

const t = stats.totals;
const rangeLabel = `${musicDate(stats.range.first)} – ${musicDate(stats.range.last)}`;
const years = stats.years.map((y) => y.year);

// En çok dinlenen şarkılar: bir sanatçının en fazla 2 şarkısı listede yer alsın.
const trackQuota = new Map<string, number>();
const topTracks: typeof tracks = [];
for (const tr of tracks) {
	const n = trackQuota.get(tr.artist) || 0;
	if (n >= 2) continue;
	trackQuota.set(tr.artist, n + 1);
	topTracks.push(tr);
	if (topTracks.length >= 10) break;
}

// En çok dinlenen albümler: bir sanatçının en fazla 1 albümü listede yer alsın.
const albumQuota = new Set<string>();
const topAlbums: typeof albums = [];
for (const al of albums) {
	if (albumQuota.has(al.artist)) continue;
	albumQuota.add(al.artist);
	topAlbums.push(al);
	if (topAlbums.length >= 10) break;
}

// ------------------------------------------------------------------ grafikler
function bars(
	data: { label: string; value: number }[],
	aria: string,
	fmt: (n: number) => string = (n) => integer(n),
): string {
	const W = 760;
	const H = 260;
	const mL = 10;
	const mR = 10;
	const mT = 26;
	const mB = 34;
	const max = Math.max(...data.map((d) => d.value), 1);
	const n = data.length;
	const innerW = W - mL - mR;
	const innerH = H - mT - mB;
	const step = innerW / n;
	const bw = Math.min(46, step * 0.62);
	let s = `<svg viewBox="0 0 ${W} ${H}" class="chart" role="img" aria-label="${aria}">`;
	data.forEach((d, i) => {
		const h = Math.max(1, (d.value / max) * innerH);
		const x = mL + step * i + (step - bw) / 2;
		const y = mT + innerH - h;
		s += `<rect class="bar" x="${x.toFixed(1)}" y="${y.toFixed(1)}" width="${bw.toFixed(1)}" height="${h.toFixed(1)}" rx="3"/>`;
		s += `<text class="val" x="${(x + bw / 2).toFixed(1)}" y="${(y - 6).toFixed(1)}" text-anchor="middle">${fmt(d.value)}</text>`;
		s += `<text class="lbl" x="${(x + bw / 2).toFixed(1)}" y="${H - 12}" text-anchor="middle">${d.label}</text>`;
	});
	return s + '</svg>';
}

// saat × gün ısı haritası (Pazartesi'den başlar)
const hourOrder = [1, 2, 3, 4, 5, 6, 0];
const whMax = Math.max(...stats.weekdayHour.flat(), 1);

// takvim ısı haritası — günlük çalma, %95 eşiğine göre ölçeklenir
const sortedDayPlays = stats.days.map((d) => d.plays).sort((a, b) => a - b);
const p95 = sortedDayPlays[Math.floor(sortedDayPlays.length * 0.95)] || 1;
const calCap = Math.max(20, p95);
const dayMap = new Map(stats.days.map((d) => [d.d, d.plays]));
const calYears = stats.years.map((y) => y.year);

function calendarSVG(year: number): string {
	const cell = 11;
	const gap = 2;
	const step = cell + gap;
	const first = new Date(Date.UTC(year, 0, 1));
	const startDow = (first.getUTCDay() + 6) % 7; // Pazartesi = 0
	const daysInYear = (Date.UTC(year, 11, 31) - Date.UTC(year, 0, 1)) / 86400000 + 1;
	const W = 54 * step;
	const H = 7 * step;
	let s = `<svg viewBox="0 0 ${W} ${H}" class="cal-svg" role="img" aria-label="${year} takvim ısı haritası">`;
	for (let d = 0; d < daysInYear; d++) {
		const date = new Date(Date.UTC(year, 0, 1 + d));
		const ymd = `${year}-${String(date.getUTCMonth() + 1).padStart(2, '0')}-${String(date.getUTCDate()).padStart(2, '0')}`;
		const plays = dayMap.get(ymd) || 0;
		const idx = startDow + d;
		const col = Math.floor(idx / 7);
		const row = idx % 7;
		const op = plays ? (0.16 + 0.84 * Math.min(1, plays / calCap)).toFixed(2) : '0.05';
		s += `<rect class="cd" x="${col * step}" y="${row * step}" width="${cell}" height="${cell}" rx="2" style="opacity:${op}"><title>${ymd} — ${plays} çalma</title></rect>`;
	}
	return s + '</svg>';
}

const m = stats.milestones;
const dowNames = ['Pazar', 'Pazartesi', 'Salı', 'Çarşamba', 'Perşembe', 'Cuma', 'Cumartesi'];
---

<Base
	title="Müzik"
	description={`2016–2026 Spotify dinleme arşivim: ${integer(t.scrobbles)} çalma, ${integer(t.hours)} saat, ${integer(t.artists)} sanatçı.`}
>
	<div class="container section">
		<header class="page-head">
			<p class="eyebrow">Arşiv</p>
			<h1>Müzik</h1>
			<p class="lede">
				{rangeLabel} arası Spotify dinleme geçmişim. Toplam {integer(t.hours)} saat, {integer(t.scrobbles)} çalma,
				{integer(t.artists)} sanatçı.
			</p>
		</header>

		<!-- en çok dinlenen sanatçılar (1) -->
		<section class="panel" data-muzik-kat="sanatci">
			<div class="section-head">
				<h2>En çok dinlenen sanatçılar</h2>
				<div class="yr-tabs" role="group" aria-label="Yıl seçimi">
					<button type="button" class="yr-tab is-on" data-yil="" aria-pressed="true">Tümü</button>
					{years.map((y) => <button type="button" class="yr-tab" data-yil={String(y)} aria-pressed="false">{y}</button>)}
				</div>
				<a class="more" href="/muzik/sanatcilar" data-yil-link data-base="/muzik/sanatcilar">Tümü →</a>
			</div>
			<ul class="grid" data-yil-list>
				{stats.topArtists.map((a, i) => (
					<MusicCard href={`/muzik/sanatci/${a.slug}`} title={a.name} src={cover('artist', a.slug)} round plays={a.plays} rank={i + 1} />
				))}
			</ul>
			<p class="yr-empty muted" hidden>Bu yıl için kayıt yok.</p>
		</section>

		<!-- en çok dinlenen türler (2) — satır listesi -->
		<section class="panel" data-muzik-kat="tur">
			<div class="section-head">
				<h2>En çok dinlenen türler</h2>
				<div class="yr-tabs" role="group" aria-label="Yıl seçimi">
					<button type="button" class="yr-tab is-on" data-yil="" aria-pressed="true">Tümü</button>
					{years.map((y) => <button type="button" class="yr-tab" data-yil={String(y)} aria-pressed="false">{y}</button>)}
				</div>
				<a class="more" href="/muzik/turler" data-yil-link data-base="/muzik/turler">Tümü →</a>
			</div>
			<p class="panel-note muted">Bir sanatçı birden fazla türde sayıldığı için türler birbirini kapsar (örn. metal; black, doom ve death metal'i içerir); toplamları toplamayın.</p>
			<ul class="lines" data-yil-list>
				{genres.slice(0, 10).map((g, i) => (
					<li class="mline">
						<span class="rk">{i + 1}</span>
						<MusicCover name={g.name} alt="" />
						<span class="txt">
							<span class="t">{g.name}</span>
							<span class="s muted">{g.artists} sanatçı</span>
						</span>
						<span class="p">{integer(g.plays)} çalma</span>
					</li>
				))}
			</ul>
			<p class="yr-empty muted" hidden>Bu yıl için kayıt yok.</p>
		</section>

		<!-- en çok dinlenen albümler (3) -->
		<section class="panel" data-muzik-kat="album">
			<div class="section-head">
				<h2>En çok dinlenen albümler</h2>
				<div class="yr-tabs" role="group" aria-label="Yıl seçimi">
					<button type="button" class="yr-tab is-on" data-yil="" aria-pressed="true">Tümü</button>
					{years.map((y) => <button type="button" class="yr-tab" data-yil={String(y)} aria-pressed="false">{y}</button>)}
				</div>
				<a class="more" href="/muzik/albumler" data-yil-link data-base="/muzik/albumler">Tümü →</a>
			</div>
			<ul class="grid" data-yil-list>
				{topAlbums.map((a, i) => (
					<MusicCard href={`/muzik/album/${a.slug}`} title={a.name} sub={a.artist} src={cover('album', a.slug)} plays={a.plays} rank={i + 1} />
				))}
			</ul>
			<p class="yr-empty muted" hidden>Bu yıl için kayıt yok.</p>
		</section>

		<!-- en çok dinlenen şarkılar (4) — satır listesi -->
		<section class="panel" data-muzik-kat="sarki">
			<div class="section-head">
				<h2>En çok dinlenen şarkılar</h2>
				<div class="yr-tabs" role="group" aria-label="Yıl seçimi">
					<button type="button" class="yr-tab is-on" data-yil="" aria-pressed="true">Tümü</button>
					{years.map((y) => <button type="button" class="yr-tab" data-yil={String(y)} aria-pressed="false">{y}</button>)}
				</div>
				<a class="more" href="/muzik/sarkilar" data-yil-link data-base="/muzik/sarkilar">Tümü →</a>
			</div>
			<ul class="lines" data-yil-list>
				{topTracks.map((tr, i) => (
					<li class="mline">
						<span class="rk">{i + 1}</span>
						<a class="row-link" href={`/muzik/sarki/${tr.slug}`}>
							<MusicCover src={cover('track', tr.slug)} alt="" name={tr.name} />
							<span class="txt">
								<span class="t">{tr.name}</span>
								<span class="s muted">{tr.artist}</span>
							</span>
							<span class="p">{integer(tr.plays)} çalma</span>
						</a>
					</li>
				))}
			</ul>
			<p class="yr-empty muted" hidden>Bu yıl için kayıt yok.</p>
		</section>

		<!-- özet -->
		<section class="panel">
			<div class="tiles">
				<div class="tile"><span class="k">Dinleme</span><span class="v">{integer(t.hours)}</span><span class="u">saat</span></div>
				<div class="tile"><span class="k">Çalma</span><span class="v">{integer(t.scrobbles)}</span><span class="u">≥30 sn</span></div>
				<div class="tile"><span class="k">Sanatçı</span><span class="v">{integer(t.artists)}</span><span class="u">farklı</span></div>
				<div class="tile"><span class="k">Albüm</span><span class="v">{integer(t.albums)}</span><span class="u">farklı</span></div>
				<div class="tile"><span class="k">Şarkı</span><span class="v">{integer(t.tracks)}</span><span class="u">farklı</span></div>
				<div class="tile"><span class="k">Dinlenen gün</span><span class="v">{integer(t.days)}</span><span class="u">gün</span></div>
			</div>
		</section>

		<!-- yıllara göre -->
		<section class="panel">
			<div class="section-head">
				<h2>Yıllara göre</h2>
				<span class="more muted">yıllık çalma sayısı</span>
			</div>
			<div class="mchart" set:html={bars(stats.years.map((y) => ({ label: String(y.year), value: y.plays })), 'Yıllara göre çalma sayısı')} />
		</section>

		<!-- keşif -->
		<section class="panel">
			<div class="section-head">
				<h2>Keşif</h2>
				<span class="more muted">o yıl ilk kez dinlenen sanatçı sayısı</span>
			</div>
			<div class="mchart" set:html={bars(stats.years.map((y) => ({ label: String(y.year), value: y.newArtists })), 'Yıllara göre yeni sanatçı sayısı')} />
		</section>

		<!-- ne zaman dinliyorum -->
		<section class="panel">
			<div class="section-head">
				<h2>Ne zaman dinliyorum</h2>
				<span class="more muted">saat × gün</span>
			</div>
			<div class="heat">
				<div class="heat-corner"></div>
				{Array.from({ length: 24 }).map((_, h) => <span class="heat-h">{h % 3 === 0 ? h : ''}</span>)}
				{hourOrder.map((d) => (
					<>
						<span class="heat-d">{WEEKDAYS_TR[(d + 6) % 7]}</span>
						{Array.from({ length: 24 }).map((_, h) => {
							const v = stats.weekdayHour[d][h];
							const op = v ? (0.14 + 0.86 * (v / whMax)).toFixed(2) : '0.04';
							return <span class="heat-c" style={`opacity:${op}`} title={`${dowNames[d]} ${h}:00 — ${integer(v)} çalma`}></span>;
						})}
					</>
				))}
			</div>
			<p class="muted small">En yoğun saat <strong>{String(m.busiestHour.hour).padStart(2, '0')}:00</strong> · en çok {dowNames[m.topDow.dow]} günleri.</p>
		</section>

		<!-- yıl yıl takvim -->
		<section class="panel">
			<div class="section-head">
				<h2>Yıl yıl</h2>
				<span class="more muted">günlük yoğunluk</span>
			</div>
			<div class="cal">
				{calYears.map((y) => (
					<div class="cal-row">
						<span class="cal-year">{y}</span>
						<div set:html={calendarSVG(y)} />
					</div>
				))}
			</div>
		</section>

		<!-- kilometre taşları -->
		<section class="panel">
			<div class="section-head"><h2>Kilometre taşları</h2></div>
			<ul class="marks">
				{m.firstPlay && (
					<li>
						<span class="mk">İlk çalma</span>
						<span class="mv">«{m.firstPlay.name}» — {m.firstPlay.artist}</span>
						<span class="md">{musicDate(m.firstPlay.ts)}</span>
					</li>
				)}
				{m.mostPlayedTrack && (
					<li>
						<span class="mk">En çok dinlenen şarkı</span>
						<span class="mv"><a href={`/muzik/sarki/${m.mostPlayedTrack.slug}`}>«{m.mostPlayedTrack.name}»</a> — {m.mostPlayedTrack.artist}</span>
						<span class="md">{integer(m.mostPlayedTrack.plays)} çalma</span>
					</li>
				)}
				{m.mostPlayedAlbum && (
					<li>
						<span class="mk">En çok dinlenen albüm</span>
						<span class="mv"><a href={`/muzik/album/${m.mostPlayedAlbum.slug}`}>{m.mostPlayedAlbum.name}</a> — {m.mostPlayedAlbum.artist}</span>
						<span class="md">{integer(m.mostPlayedAlbum.plays)} çalma</span>
					</li>
				)}
				{m.mostPlayedArtist && (
					<li>
						<span class="mk">En çok dinlenen sanatçı</span>
						<span class="mv"><a href={`/muzik/sanatci/${m.mostPlayedArtist.slug}`}>{m.mostPlayedArtist.name}</a></span>
						<span class="md">{integer(m.mostPlayedArtist.plays)} çalma</span>
					</li>
				)}
				<li>
					<span class="mk">En yoğun gün</span>
					<span class="mv">{dayLabel(m.busiestDay.d)}</span>
					<span class="md">{integer(m.busiestDay.plays)} çalma</span>
				</li>
				<li>
					<span class="mk">En uzun seri</span>
					<span class="mv">{integer(m.longestStreak.days)} gün kesintisiz</span>
					<span class="md">{dayLabel(m.longestStreak.start)} – {dayLabel(m.longestStreak.end)}</span>
				</li>
			</ul>
		</section>
	</div>
</Base>

<script>
	// Yıl sekmeleri: /muzik'te her sekmede yalnızca İLK 10 gösterilir
	// (Tümü = tüm zamanların ilk 10'u; yıl = o yılın ilk 10'u). Veri
	// /data/muzik/yil/<yil>-<kat>.json dosyasından tembel yüklenir ve dilimlenir.
	type YearItem = { name: string; sub?: string; plays: number; href: string | null; img: string | null };
	const cache = new Map<string, { items: YearItem[] }>();
	const HOME_LIMIT = 10;

	document.querySelectorAll<HTMLElement>('[data-muzik-kat]').forEach((panel) => {
		const kat = panel.dataset.muzikKat;
		const list = panel.querySelector<HTMLElement>('[data-yil-list]');
		const empty = panel.querySelector<HTMLElement>('.yr-empty');
		const tabs = Array.from(panel.querySelectorAll<HTMLButtonElement>('.yr-tab'));
		const moreLink = panel.querySelector<HTMLAnchorElement>('.more[data-yil-link]');
		if (!kat || !list || !empty || !tabs.length) return;

		// kart (.mcard) veya satır (.mline) şablonu; kapsüllü stiller korunur
		const template = list.querySelector('.mcard, .mline') as HTMLElement | null;
		const defaultHTML = list.innerHTML; // "Tümü" görünümü (ilk 10)
		let token = 0;
		const fmt = (n: number) => Math.round(n).toLocaleString('tr-TR');

		/** "… →" bağlantısına seçili yılı ?yil= olarak taşır (Tümü = taşımaz). */
		const syncMoreLink = (yil: string) => {
			if (!moreLink) return;
			const base = moreLink.dataset.base || moreLink.getAttribute('href') || '';
			moreLink.setAttribute('href', yil ? `${base}?yil=${yil}` : base);
		};

		const render = (items: YearItem[]) => {
			if (!template) return;
			const frag = document.createDocumentFragment();
			items.slice(0, HOME_LIMIT).forEach((it, i) => {
				const li = template.cloneNode(true) as HTMLElement;
				const card = li.querySelector('a');
				if (card) {
					if (it.href) card.setAttribute('href', it.href);
					else card.removeAttribute('href'); // detay sayfası yoksa bağlantı kaldırılır
				}
				const rank = li.querySelector('.rank, .rk');
				if (rank) rank.textContent = String(i + 1);
				const title = li.querySelector('.t');
				if (title) title.textContent = it.name || '(isimsiz)';
				const sub = li.querySelector<HTMLElement>('.s');
				if (sub) {
					sub.textContent = it.sub || '';
					sub.style.display = it.sub ? '' : 'none';
				}
				const plays = li.querySelector('.p');
				if (plays) plays.textContent = `${fmt(it.plays)} çalma`;
				const img = li.querySelector<HTMLImageElement>('.mcover img');
				if (img) {
					if (it.img) img.setAttribute('src', it.img);
					else img.remove();
				}
				frag.append(li);
			});
			list.replaceChildren(frag);
			empty.hidden = items.length > 0;
		};

		for (const tab of tabs) {
			tab.addEventListener('click', async () => {
				const yil = tab.dataset.yil || '';
				for (const b of tabs) {
					const on = b === tab;
					b.classList.toggle('is-on', on);
					b.setAttribute('aria-pressed', String(on));
				}
				syncMoreLink(yil);
				const my = ++token; // son tıklama kazanır
				if (!yil) {
					empty.hidden = true;
					list.innerHTML = defaultHTML;
					return;
				}
				// anahtar kategoriyle birlikte: yoksa paneller birbirinin listesini gösterir
				const key = `${kat}:${yil}`;
				if (!cache.has(key)) {
					try {
						const res = await fetch(`/data/muzik/yil/${yil}-${kat}.json`);
						const data = (await res.json()) as { items: YearItem[] };
						// tür panelinde sıralama anahtarı = ekrandaki çalma sayısı (eşitlikte ad A→Z)
						if (kat === 'tur') data.items.sort((a, b) => b.plays - a.plays || a.name.localeCompare(b.name, 'tr'));
						cache.set(key, data);
					} catch {
						cache.set(key, { items: [] });
					}
				}
				if (my !== token) return;
				render(cache.get(key)!.items);
			});
		}
	});
</script>

<style>
	.page-head {
		margin-bottom: 2rem;
	}
	.page-head h1 {
		margin-block: 0.2rem 0.6rem;
	}
	.panel {
		margin-bottom: var(--gap);
	}

	/* yıl sekmeleri (başlık satırının sağı) */
	.yr-tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 2px;
		margin-left: auto;
	}
	.yr-tab {
		font-family: var(--font-ui);
		font-size: 0.66rem;
		letter-spacing: 0.04em;
		line-height: 1;
		padding: 0.28rem 0.5rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: transparent;
		color: var(--text-muted);
		cursor: pointer;
		transition:
			color var(--dur) var(--ease),
			border-color var(--dur) var(--ease);
	}
	.yr-tab:hover {
		color: var(--text);
		border-color: var(--border-strong);
	}
	.yr-tab.is-on {
		color: var(--accent-2);
		border-color: var(--accent);
		background: var(--accent-soft);
	}
	.yr-empty {
		margin: 0.5rem 0 0;
		font-family: var(--font-meta);
		font-size: 0.85rem;
	}
	.panel-note {
		margin: -0.85rem 0 1rem;
		font-family: var(--font-meta);
		font-size: 0.82rem;
		line-height: 1.45;
	}

	/* satır listesi (türler, şarkılar) */
	.lines {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.mline {
		border-top: 1px solid var(--border);
		display: grid;
		grid-template-columns: 2rem 48px 1fr auto;
		align-items: center;
		column-gap: 0.9rem;
		padding: 0.45rem 0.4rem;
	}
	.mline:has(> a.row-link):hover {
		background: var(--surface-2);
	}
	.mline > a.row-link {
		display: contents;
		color: inherit;
		text-decoration: none;
	}
	.mline .rk {
		font-family: var(--font-ui);
