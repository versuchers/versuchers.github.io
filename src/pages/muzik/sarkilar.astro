---
import Base from '../../layouts/Base.astro';
import MusicBrowse from '../../components/MusicBrowse.astro';
import { tracks, cover } from '../../lib/music';

const rows = tracks.map((t) => ({
	href: `/muzik/sarki/${t.slug}`,
	title: t.name,
	sub: `${t.artist} · ${t.album}`,
	src: cover('track', t.slug),
	plays: t.plays,
}));
---

<Base
	title="Müzik — Şarkılar"
	description="En çok dinlediğim ilk 666 şarkı."
>
	<div class="container section">
		<header class="page-head">
			<p class="eyebrow">Müzik</p>
			<h1>Şarkılar</h1>
			<p class="lede">En çok dinlediğim ilk 666 şarkı; çalma sayısına göre.</p>
		</header>
		<MusicBrowse
			label="Şarkılar"
			unit="şarkı"
			indexUrl="/search-index/muzik-sarki.json"
			rows={rows}
		/>
	</div>
</Base>

<style>
	.page-head {
		margin-bottom: 2rem;
	}
	.page-head h1 {
		margin-block: 0.2rem 0.6rem;
	}
</style>
