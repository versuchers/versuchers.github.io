---
interface Props {
	src?: string;
	/** Görselin alternatif metni; yanında aynı ad yazıyorsa boş bırakın (dekoratif). */
	alt?: string;
	/** Harf madalyonu için kayıt adı (yoksa `alt` kullanılır). */
	name?: string;
	/** Sanatçı görselleri yuvarlak gösterilir. */
	round?: boolean;
	eager?: boolean;
}

const { src, alt = '', name, round = false, eager = false } = Astro.props;

/** İlk anlamlı harf: görünmez karakterler ve vekil çiftler (emoji) dikkate alınır. */
function firstLetter(value: string): string {
	const clean = (value || '').replace(/[\u200b-\u200d\ufeff\u00ad]/gi, '').trim();
	const ch = Array.from(clean)[0];
	return ch ? ch.toLocaleUpperCase('tr') : '?';
}

const initial = firstLetter(name ?? alt);
---

<figure class:list={['mcover', { round }]}>
	<span class="mono" aria-hidden="true">{initial}</span>
	{
		src && (
			<img
				src={src}
				alt={alt}
				loading={eager ? 'eager' : 'lazy'}
				decoding="async"
				referrerpolicy="no-referrer"
				data-cover-img
				onload="this.dataset.loaded = ''"
				onerror="this.remove()"
			/>
		)
	}
</figure>

<style>
	.mcover {
		position: relative;
		aspect-ratio: 1 / 1;
		background: linear-gradient(135deg, var(--surface-2), var(--surface));
		border-radius: var(--radius-sm);
		overflow: hidden;
		display: grid;
		place-items: center;
		container-type: inline-size;
	}
	.mcover.round {
		border-radius: 50%;
	}
	.mono {
		font-family: var(--font-display);
		font-size: clamp(0.85rem, 36cqw, 4rem);
		color: var(--text-faint);
		line-height: 1;
		user-select: none;
	}
	.mcover img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 420ms var(--ease);
		/* Görsel gerçekten yüklenene kadar gizli: yarı yüklenmiş katman harf
		   madalyonunun üstünü boyayıp başka bir görseli andırıyordu. */
		opacity: 0;
	}
	.mcover img[data-loaded] {
		opacity: 1;
	}
	@media (prefers-reduced-motion: no-preference) {
		.mcover img {
			transition: transform 420ms var(--ease), opacity 220ms var(--ease);
		}
	}
</style>
