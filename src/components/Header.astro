---
import ThemeToggle from './ThemeToggle.astro';

// Açılır gruplar: üzerine gelince (masaüstü) ya da dokununca açılır.
const groups = [
	{
		label: 'İzliyorum',
		items: [
			{ href: '/film', label: 'Film' },
			{ href: '/dizi', label: 'Dizi' },
		],
	},
	{
		label: 'Dinliyorum',
		items: [
			{ href: '/playlist', label: 'Playlistler' },
			{ href: '/muzik', label: 'Dinleme Arşivi' },
		],
	},
];

const singles = [
	{ href: '/kitap', label: 'Okuyorum' },
	{ href: '/blog', label: 'Blog' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="site-header">
	<div class="container topbar">
		<a class="brand" href="/">
			<span class="word" aria-hidden="true">VERSUCHER</span>
			<span class="visually-hidden">Versucher, ana sayfa</span>
		</a>
	</div>

	<div class="container bar">
		<nav class="main-nav" aria-label="Ana gezinme">
			{
				groups.map((group) => (
					<div class="nav-group" data-nav-group>
						<button
							type="button"
							class:list={[
								'nav-link',
								'nav-trigger',
								{ active: group.items.some((item) => isActive(item.href)) },
							]}
							aria-haspopup="true"
							aria-expanded="false"
						>
							{group.label}
							<span class="caret" aria-hidden="true">▾</span>
						</button>
						<div class="nav-menu">
							{group.items.map((item) => (
								<a
									href={item.href}
									class:list={['nav-sub', { active: isActive(item.href) }]}
								>
									{item.label}
								</a>
							))}
						</div>
					</div>
				))
			}
			{
				singles.map((item) => (
					<a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]}>
						{item.label}
					</a>
				))
			}
		</nav>

		<div class="actions">
			<a class="search-link" href="/ara" title="Ara" aria-label="Ara">⌕</a>
			<ThemeToggle />
			<button
				type="button"
				class="menu-btn"
				aria-label="Menü"
				aria-expanded="false"
				aria-controls="mobile-nav"
				data-menu-btn
			>
				<span class="bars" aria-hidden="true">☰</span>
				<span class="x" aria-hidden="true">✕</span>
			</button>
		</div>
	</div>

	<div class="mobile-panel" id="mobile-nav" data-mobile-panel>
		<a class="m-search" href="/ara">
			<span class="m-ico" aria-hidden="true">⌕</span>
			<span>Ara</span>
		</a>
		{
			groups.map((group) => (
				<div class="m-group">
					<p class="m-group-label">{group.label}</p>
					{group.items.map((item) => (
						<a href={item.href} class:list={['m-link', { active: isActive(item.href) }]}>
							{item.label}
						</a>
					))}
				</div>
			))
		}
		{
			singles.map((item) => (
				<a href={item.href} class:list={['m-link', { active: isActive(item.href) }]}>
					{item.label}
				</a>
			))
		}
	</div>
</header>

<script>
	const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-group]'));

	function closeAll(except?: HTMLElement) {
		for (const group of groups) {
			if (group === except) continue;
			group.classList.remove('open');
			group.querySelector('button')?.setAttribute('aria-expanded', 'false');
		}
	}

	// Dokunmatikte hover olmadığı için menüler dokunuşla açılır.
	// Masaüstünde açma/kapama tamamen CSS (:hover / :focus-within) ile yapılır.
	const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
	if (!canHover) {
		for (const group of groups) {
			const btn = group.querySelector<HTMLButtonElement>('button');
			if (!btn) continue;
			btn.addEventListener('click', (event) => {
				event.preventDefault();
				const open = !group.classList.contains('open');
				closeAll(group);
				group.classList.toggle('open', open);
				btn.setAttribute('aria-expanded', String(open));
			});
		}
		document.addEventListener('click', (event) => {
			if (!(event.target as Element | null)?.closest('[data-nav-group]')) closeAll();
		});
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') closeAll();
		});
	}

	// Mobil menü (≤768px): hamburger ile aç/kapat.
	const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
	const panel = document.querySelector<HTMLElement>('[data-mobile-panel]');

	if (menuBtn && panel) {
		const setMenu = (open: boolean) => {
			panel.classList.toggle('open', open);
			menuBtn.setAttribute('aria-expanded', String(open));
		};
		menuBtn.addEventListener('click', () => setMenu(!panel.classList.contains('open')));
		panel.addEventListener('click', (event) => {
			if ((event.target as Element | null)?.closest('a')) setMenu(false);
		});
		document.addEventListener('click', (event) => {
			const el = event.target as Element | null;
			if (el && !el.closest('[data-mobile-panel]') && !el.closest('[data-menu-btn]')) setMenu(false);
		});
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') setMenu(false);
		});
		window.matchMedia('(min-width: 769px)').addEventListener('change', (event) => {
			if (event.matches) setMenu(false);
		});
	}
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: color-mix(in srgb, var(--bg) 82%, transparent);
		backdrop-filter: var(--header-blur);
		border-bottom: 1px solid var(--border);
	}

	/* Üst bar: marka tam ortada. Yüksekliği alt barla (3.25rem) aynıdır. */
	.topbar {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 3.25rem;
	}

	/* Alt bar: menü ortada (1fr auto 1fr), aksiyonlar sağa yaslı. */
	.bar {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		height: 3.25rem;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-display);
		font-weight: 400;
		font-size: clamp(1.9rem, 6vw, 2.75rem);
		line-height: 1;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		white-space: nowrap;
		transform-origin: left center;
		transition: transform 420ms var(--ease), color var(--dur) var(--ease);
	}

	/* Görsellerdeki yakınlaşma efektine benzer: hafif büyüme + renk değişimi */
	.brand:hover {
		transform: scale(1.045);
		color: var(--accent);
	}

	nav {
		grid-column: 2;
		display: flex;
		align-items: center;
		align-self: stretch;
		gap: 0.35rem;
	}

	/* Menü bağlantıları varsayılan olarak çerçevesiz; çip çerçevesi yalnızca
	   hover'da belirir. */
	.nav-link {
		padding: 0.24em 0.7em;
		border: 1px solid transparent;
		border-radius: var(--radius-sm);
		background: none;
		font-family: var(--font-display);
		font-size: 20px;
		line-height: 1.5;
		letter-spacing: 0.02em;
		text-transform: lowercase;
		color: var(--text-muted);
		transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease),
			background-color var(--dur) var(--ease);
	}

	.nav-link:hover {
		color: var(--link-hover);
		border-color: var(--link-hover);
		background: var(--accent-soft);
	}

	/* Aktif bölüm: kullanıcı hangi menünün altındaysa o bağlantı çerçeveli
	   durur (statik, hover gerektirmez). */
	.nav-link.active {
		color: var(--text);
		border-color: var(--accent);
		background: var(--accent-soft);
	}

	.nav-link.active:hover {
		border-color: var(--link-hover);
	}

	/* --- Açılır menü grupları --- */
	.nav-group {
		position: relative;
		display: flex;
		align-items: center;
		align-self: stretch;
	}

	/* Açılır menü tetikleyicisi: çip çerçevesini .nav-link'ten alır,
	   burada yalnızca yerleşim ayarlanır. */
	.nav-trigger {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		cursor: pointer;
	}

	.nav-trigger .caret {
		font-size: 0.62em;
		color: var(--text-faint);
		transition: transform var(--dur) var(--ease);
	}

	.nav-group:hover .caret,
	.nav-group.open .caret,
	.nav-group:focus-within .caret {
		transform: rotate(180deg);
	}

	.nav-menu {
		position: absolute;
		top: 100%;
		left: 50%;
		transform: translateX(-50%);
		display: none;
		gap: 0.3rem;
		padding: 0.5rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
		box-shadow: var(--shadow);
		white-space: nowrap;
		z-index: 1;
	}

	.nav-group.open .nav-menu,
	.nav-group:focus-within .nav-menu {
		display: flex;
	}

	@media (hover: hover) and (pointer: fine) {
		.nav-group:hover .nav-menu {
			display: flex;
		}
	}

	/* Alt menü bağlantıları da yalnızca hover'da çerçevelenir. */
	.nav-sub {
		padding: 0.24em 0.7em;
		border: 1px solid transparent;
		border-radius: var(--radius-sm);
		background: none;
		font-family: var(--font-display);
		font-size: 20px;
		line-height: 1.5;
		letter-spacing: 0.02em;
		text-transform: lowercase;
		color: var(--text-muted);
		transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease),
			background-color var(--dur) var(--ease);
	}

	.nav-sub:hover {
		color: var(--link-hover);
		border-color: var(--link-hover);
		background: var(--accent-soft);
	}

	/* Aktif alt bağlantı da çerçeveli durur. */
	.nav-sub.active {
		color: var(--text);
		border-color: var(--accent);
		background: var(--accent-soft);
	}

	.nav-sub.active:hover {
		border-color: var(--link-hover);
	}

	.actions {
		grid-column: 3;
		justify-self: end;
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}

	.search-link {
		width: 1.9rem;
		height: 1.9rem;
		display: grid;
		place-items: center;
		border-radius: 999px;
		color: var(--text-muted);
		font-size: 1.1rem;
	}
	.search-link:hover {
		color: var(--accent);
		background: var(--surface-2);
	}

	/* --- Mobil menü (hamburger + açılır panel) --- */
	.menu-btn {
		display: none;
		width: 2.2rem;
		height: 2.2rem;
		place-items: center;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: var(--surface-2);
		color: var(--text-muted);
		font-size: 1.05rem;
		line-height: 1;
	}
	.menu-btn:hover {
		color: var(--text);
	}
	.menu-btn .x {
		display: none;
	}
	.menu-btn[aria-expanded='true'] .bars {
		display: none;
	}
	.menu-btn[aria-expanded='true'] .x {
		display: inline;
	}

	.mobile-panel {
		display: none;
		position: absolute;
		top: 100%;
		left: 0;
		right: 0;
		max-height: min(75vh, 34rem);
		overflow-y: auto;
		background: var(--surface);
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
		box-shadow: var(--shadow);
		padding: 0.5rem clamp(1rem, 4vw, 2.5rem) 1rem;
	}
	.mobile-panel.open {
		display: block;
	}
	.m-search {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.75rem 0.4rem;
		border-bottom: 1px solid var(--border);
		font-family: var(--font-card);
		color: var(--text);
	}
	.m-ico {
		font-size: 1.1rem;
		color: var(--accent);
	}
	.m-group {
		padding-top: 0.5rem;
	}
	.m-group-label {
		margin: 0.2rem 0;
		padding: 0 0.4rem;
		font-family: var(--font-ui);
		font-size: 0.7rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--text-faint);
	}
	.m-link {
		display: block;
		padding: 0.6rem 0.4rem;
		border-radius: var(--radius-sm);
		font-family: var(--font-card);
		font-size: 1.05rem;
		color: var(--text-muted);
	}
	.m-link:hover,
	.m-link.active {
		color: var(--text);
		background: var(--surface-2);
	}

	@media (max-width: 900px) {
		.brand {
			font-size: 1.45rem;
			letter-spacing: 0.05em;
		}
	}
	@media (max-width: 768px) {
		/* Masaüstü menüsü yerine hamburger + açılır panel. */
		.main-nav {
			display: none;
		}
		.search-link {
			display: none;
		}
		.menu-btn {
			display: grid;
		}
		/* Menü + tema butonları alt barda ortalanır (bar yüksekliği sabit kalır). */
		.bar {
			grid-template-columns: 1fr;
		}
		.actions {
			grid-column: 1;
			justify-self: center;
		}
	}
	@media (max-width: 640px) {
		.bar {
			gap: 0.5rem;
		}
		.brand {
			font-size: 1.1rem;
			letter-spacing: 0.04em;
		}
	}
	@media (max-width: 600px) {
		/* En dar mobilde: marka küçük harfle ve üst barı doldurur.
		   Yalnızca font-size büyür; harf aralığı em cinsinden kaldığı için
		   metin aşağıdan/yukarıdan çekilmiş gibi uzamaz. */
		.brand {
			font-size: 2.55rem;
			letter-spacing: 0.03em;
			text-transform: lowercase;
		}
		.menu-btn {
			width: 2rem;
			height: 2rem;
			font-size: 1rem;
		}
	}
</style>
