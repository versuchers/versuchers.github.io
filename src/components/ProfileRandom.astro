---
import { profiles } from '../data/profiles';
import { brandIcons } from '../lib/brand-icons';

// Yalnızca doldurulmuş (url'i olan) profiller gösterilir.
const list = profiles.filter((p) => typeof p.url === 'string' && p.url.trim() !== '');
const initial = list.length ? Math.floor(Math.random() * list.length) : -1;

const items = list.map((p) => ({
	name: p.name,
	url: p.url,
	note: p.note ?? '',
	icon: (p.slug && brandIcons[p.slug]) || '',
}));
---

{
	list.length > 0 && (
		<aside class="profiles" data-profiles={JSON.stringify(items)} data-index={initial}>
			<p class="profiles-label">Buralarda da varım</p>
			<a
				class="profile"
				href={list[initial].url}
				target="_blank"
				rel="me noopener noreferrer"
			>
				<span class="profile-icon" aria-hidden="true">
					{items[initial].icon ? (
						<svg viewBox="0 0 24 24" fill="currentColor">
							<path d={items[initial].icon} />
						</svg>
					) : (
						<span class="profile-monogram">{list[initial].name.trim().charAt(0)}</span>
					)}
				</span>
				<span class="profile-text">
					<span class="profile-name">{list[initial].name}</span>
					<span class="profile-note">{list[initial].note}</span>
				</span>
			</a>
			<button class="profile-refresh" type="button">↻ Başka bir yer</button>
		</aside>
	)
}

<style>
	.profiles {
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
		padding: 1.15rem 1.25rem 1rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--bg-2);
	}

	.profiles-label {
		margin: 0;
		font-family: var(--font-ui);
		font-size: 0.68rem;
		font-weight: 500;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--text-faint);
	}

	.profile {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		text-decoration: none;
		color: var(--text);
		min-width: 0;
	}

	.profile-icon {
		display: grid;
		place-items: center;
		width: 2.4rem;
		height: 2.4rem;
		flex: 0 0 auto;
		border-radius: 999px;
		background: var(--surface-2);
		color: var(--accent-2);
	}

	.profile-icon svg {
		width: 1.2rem;
		height: 1.2rem;
	}

	.profile-monogram {
		font-family: var(--font-card);
		font-size: 1.05rem;
		line-height: 1;
	}

	.profile-text {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.profile-name {
		font-family: var(--font-card);
		font-size: 1.15rem;
		line-height: 1.25;
		transition: color var(--dur) var(--ease);
	}

	.profile-note {
		font-family: var(--font-ui);
		font-size: 0.78rem;
		color: var(--text-muted);
	}

	.profile-note:empty {
		display: none;
	}

	.profile:hover .profile-name {
		color: var(--link-hover);
	}

	.profile-refresh {
		align-self: flex-start;
		padding: 0;
		border: 0;
		background: none;
		color: var(--text-faint);
		font-family: var(--font-ui);
		font-size: 0.74rem;
		letter-spacing: 0.04em;
		cursor: pointer;
		transition: color var(--dur) var(--ease);
	}

	.profile-refresh:hover {
		color: var(--link-hover);
	}

	@keyframes profile-swap {
		from {
			opacity: 0;
			transform: translateY(5px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	.profile.swap {
		animation: profile-swap 260ms var(--ease);
	}
</style>

<script>
	const root = document.querySelector<HTMLElement>('[data-profiles]');
	if (root) {
		const data: { name: string; url: string; note: string; icon: string }[] = JSON.parse(
			root.getAttribute('data-profiles') || '[]',
		);
		const link = root.querySelector<HTMLAnchorElement>('.profile');
		const iconEl = root.querySelector<HTMLElement>('.profile-icon');
		const nameEl = root.querySelector<HTMLElement>('.profile-name');
		const noteEl = root.querySelector<HTMLElement>('.profile-note');
		const btn = root.querySelector<HTMLButtonElement>('.profile-refresh');
		let i = Number(root.getAttribute('data-index')) || 0;

		const render = (idx: number, animate: boolean) => {
			const p = data[idx];
			if (!p || !link || !iconEl || !nameEl || !noteEl) return;
			link.href = p.url;
			link.title = p.name;
			nameEl.textContent = p.name;
			noteEl.textContent = p.note;
			iconEl.innerHTML = p.icon
				? `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="${p.icon}"></path></svg>`
				: `<span class="profile-monogram">${p.name.trim().charAt(0)}</span>`;
			if (animate) {
				link.classList.remove('swap');
				void link.offsetWidth;
				link.classList.add('swap');
			}
		};

		btn?.addEventListener('click', () => {
			if (data.length < 2) return;
			let next = i;
			while (next === i) next = Math.floor(Math.random() * data.length);
			i = next;
			render(i, true);
		});

		// Her ziyarette farklı bir profil göster (sunucudaki ilk seçim yalnız JS yokken görünür).
		if (data.length > 1) {
			let first = i;
			while (first === i) first = Math.floor(Math.random() * data.length);
			i = first;
			render(i, false);
		}
	}
</script>
