---
import MusicCover from './MusicCover.astro';
import MusicBars from './MusicBars.astro';

interface Props {
	kindLabel: string;
	kindPlural: string;
	kindHref: string;
	title: string;
	subtitle?: string;
	subtitleHref?: string;
	coverSrc?: string;
	round?: boolean;
	links?: { label: string; href: string }[];
	stats: { k: string; v: string }[];
	values: number[];
	labels: string[];
}

const {
	kindLabel,
	kindPlural,
	kindHref,
	title,
	subtitle,
	subtitleHref,
	coverSrc,
	round = false,
	links = [],
	stats,
	values,
	labels,
} = Astro.props;
---

<article class="mdet">
	<div class="container">
		<nav class="crumbs" aria-label="Kırıntı">
			<a href="/">Ana sayfa</a>
			<span aria-hidden="true">/</span>
			<a href="/muzik">Müzik</a>
			<span aria-hidden="true">/</span>
			<a href={kindHref}>{kindPlural}</a>
		</nav>

		<div class="cols">
			<div class="left">
				<MusicCover src={coverSrc} alt="" name={title} round={round} eager />
				{
					links.length > 0 && (
						<div class="links">
							{links.map((l) => (
								<a class="btn" href={l.href} target="_blank" rel="noopener noreferrer">
									{l.label}
								</a>
							))}
						</div>
					)
				}
			</div>

			<div class="right">
				<p class="eyebrow">{kindLabel}</p>
				<h1>{title}</h1>
				{
					subtitle && (
						<p class="sub">
							{subtitleHref ? <a href={subtitleHref}>{subtitle}</a> : subtitle}
						</p>
					)
				}
				<ul class="kstats">
					{
						stats.map((s) => (
							<li>
								<span class="v">{s.v}</span>
								<span class="k">{s.k}</span>
							</li>
						))
					}
				</ul>
			</div>
		</div>

		{values.some((v) => v > 0) && (
			<section class="yearly">
				<div class="section-head">
					<h2>Yıllara göre</h2>
					<span class="more muted">çalma sayısı</span>
				</div>
				<MusicBars values={values} labels={labels} aria={`${title} — yıllık çalma`} />
			</section>
		)}

		<slot />
	</div>
</article>

<style>
	.mdet {
		padding-block: 1.5rem 0;
	}
	.crumbs {
		display: flex;
		gap: 0.5rem;
		font-family: var(--font-ui);
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-muted);
		margin-bottom: 1.5rem;
	}
	.crumbs a {
		color: var(--text-muted);
	}
	.crumbs a:hover {
		color: var(--link-hover);
	}

	.cols {
		display: grid;
		grid-template-columns: minmax(200px, 280px) 1fr;
		gap: clamp(1.5rem, 4vw, 3rem);
		align-items: start;
	}
	.left {
		--poster-max: 280px;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
		margin-top: 1rem;
	}

	.eyebrow + h1 {
		margin-top: 0.2rem;
	}
	.sub {
		margin: -0.4rem 0 0;
		font-family: var(--font-card);
		font-size: 1.2rem;
		color: var(--text-muted);
	}
	.sub a:hover {
		color: var(--link-hover);
	}

	.kstats {
		list-style: none;
		margin: 1.4rem 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
		gap: 0.9rem 1.5rem;
	}
	.kstats li {
		display: flex;
		flex-direction: column;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid var(--border);
	}
	.kstats .v {
		font-family: var(--font-card);
		font-size: 1.4rem;
		line-height: 1.15;
	}
	.kstats .k {
		font-family: var(--font-ui);
		font-size: 0.66rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-faint);
	}

	.yearly {
		margin-top: clamp(2rem, 5vw, 3rem);
	}

	@media (max-width: 760px) {
		.cols {
			grid-template-columns: 1fr;
		}
		.left {
			max-width: 240px;
		}
	}
</style>
