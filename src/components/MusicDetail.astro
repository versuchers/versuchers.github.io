---
import MusicCover from './MusicCover.astro';
import MusicBars from './MusicBars.astro';

interface Props {
	kindLabel: string;
	kindPlural: string;
	kindHref: string;
	title: string;
	subtitle?: string;
	subtitleHref?: string;
	coverSrc?: string;
	round?: boolean;
	links?: { label: string; href: string }[];
	stats: { k: string; v: string }[];
	values: number[];
	labels: string[];
	/** Sanatçı sayfaları: tür (ilk 3), ülke ve dış bağlantılar. */
	artistInfo?: {
		genres: { name: string; href?: string | null }[];
		country: string;
		/** Ülkenin etiket sayfası (/ulke/<slug>); yoksa düz metin kalır. */
		countryHref?: string | null;
		links: {
			bandcamp?: string;
			discogs?: string;
			metalArchives?: string;
			spotify?: string;
			apple?: string;
			lastfm?: string;
		};
	};
}

const {
	kindLabel,
	kindPlural,
	kindHref,
	title,
	subtitle,
	subtitleHref,
	coverSrc,
	round = false,
	links = [],
	stats,
	values,
	labels,
	artistInfo,
} = Astro.props;
---

<article class:list={['mdet', { 'mdet-artist': !!artistInfo }]}>
	<div class="container">
		<nav class="crumbs" aria-label="Kırıntı">
			<a href="/">Ana sayfa</a>
			<span aria-hidden="true">/</span>
			<a href="/muzik">Müzik</a>
			<span aria-hidden="true">/</span>
			<a href={kindHref}>{kindPlural}</a>
		</nav>

		<div class="cols">
			<div class="left">
				{artistInfo && (
					<p class="artist-title" aria-hidden="true">
						{title}
					</p>
				)}
				<MusicCover src={coverSrc} alt="" name={title} round={round} eager />
				{
					artistInfo && (
						<div class="ainfo">
							{artistInfo.genres.length > 0 && (
								<ul class="a-genres">
									{artistInfo.genres.map((g) => (
										<li>{g.href ? <a href={g.href}>{g.name}</a> : g.name}</li>
									))}
								</ul>
							)}
							{artistInfo.country && (
								<p class="a-country">
									{artistInfo.countryHref ? (
										<a href={artistInfo.countryHref}>{artistInfo.country}</a>
									) : (
										artistInfo.country
									)}
								</p>
							)}
							{artistInfo.links.metalArchives && (
								<p class="a-links">
									<a href={artistInfo.links.metalArchives} target="_blank" rel="noopener noreferrer">Metal Archives</a>
								</p>
							)}
							{(artistInfo.links.bandcamp ||
								artistInfo.links.discogs ||
								artistInfo.links.spotify ||
								artistInfo.links.apple ||
								artistInfo.links.lastfm) && (
								<p class="a-icons">
									{artistInfo.links.bandcamp && (
										<a href={artistInfo.links.bandcamp} target="_blank" rel="noopener noreferrer" aria-label="Bandcamp">
											<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M0 18.75l7.437-13.5H24l-7.438 13.5H0z"/></svg>
										</a>
									)}
									{artistInfo.links.discogs && (
										<a href={artistInfo.links.discogs} target="_blank" rel="noopener noreferrer" aria-label="Discogs">
											<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M1.7422 11.982c0-5.6682 4.61-10.2782 10.2758-10.2782 1.8238 0 3.5372.48 5.0251 1.3175l.8135-1.4879C16.1768.588 14.2474.036 12.1908.0024h-.1944C5.4091.0144.072 5.3107 0 11.886v.1152c.0072 3.4389 1.4567 6.5345 3.7748 8.7207l1.1855-1.2814c-1.9798-1.8743-3.218-4.526-3.218-7.4585zM20.362 3.4053l-1.1543 1.2406c1.903 1.867 3.0885 4.4636 3.0885 7.3361 0 5.6658-4.61 10.2758-10.2758 10.2758-1.783 0-3.4605-.456-4.922-1.2575l-.8542 1.5214c1.7086.9384 3.6692 1.4735 5.7546 1.4759C18.6245 23.9976 24 18.6246 24 11.9988c-.0048-3.3717-1.399-6.4146-3.638-8.5935zM1.963 11.982c0 2.8701 1.2119 5.4619 3.146 7.2953l1.1808-1.2767c-1.591-1.5166-2.587-3.6524-2.587-6.0186 0-4.586 3.7293-8.3152 8.3152-8.3152 1.483 0 2.875.3912 4.082 1.0751l.8351-1.5262C15.481 2.395 13.8034 1.927 12.018 1.927 6.4746 1.9246 1.963 6.4362 1.963 11.982zm18.3702 0c0 4.586-3.7293 8.3152-8.3152 8.3152-1.4327 0-2.7837-.3648-3.962-1.0055l-.852 1.5166c1.4303.7823 3.0718 1.2287 4.814 1.2287 5.5434 0 10.055-4.5116 10.055-10.055 0-2.8077-1.1567-5.3467-3.0165-7.1729l-1.183 1.2743c1.519 1.507 2.4597 3.5924 2.4597 5.8986zm-1.9486 0c0 3.5109-2.8558 6.3642-6.3642 6.3642a6.3286 6.3286 0 01-3.0069-.756l-.8471 1.507c1.147.624 2.4597.9768 3.854.9768 4.4636 0 8.0944-3.6308 8.0944-8.0944 0-2.239-.9143-4.2692-2.3902-5.7378l-1.1783 1.267c1.1351 1.152 1.8383 2.731 1.8383 4.4732zm-14.4586 0c0 2.3014.9671 4.382 2.515 5.8578l1.1734-1.2695c-1.207-1.159-1.9606-2.786-1.9606-4.5883 0-3.5108 2.8557-6.3642 6.3642-6.3642 1.1423 0 2.215.3048 3.1437.8352l.8303-1.5167c-1.1759-.6647-2.5317-1.0487-3.974-1.0487-4.4612 0-8.092 3.6308-8.092 8.0944zm12.5292 0c0 2.4502-1.987 4.4372-4.4372 4.4372a4.4192 4.4192 0 01-2.0614-.5088l-.8351 1.4879a6.1135 6.1135 0 002.8965.727c3.3885 0 6.1434-2.7548 6.1434-6.1433 0-1.6774-.6767-3.1989-1.7686-4.3076l-1.1615 1.2503c.7559.7967 1.2239 1.8718 1.2239 3.0573zm-10.5806 0c0 1.7374.7247 3.3069 1.8886 4.4252L8.92 15.1569l.0144.0144c-.8351-.8063-1.3559-1.9366-1.3559-3.1869 0-2.4502 1.9846-4.4372 4.4372-4.4372.8087 0 1.5646.2184 2.2174.5976l.8207-1.4975a6.097 6.097 0 00-3.0381-.8063c-3.3837-.0048-6.141 2.7525-6.141 6.141zm6.681 0c0 .2952-.2424.5351-.5376.5351-.2952 0-.5375-.24-.5375-.5351 0-.2976.24-.5375.5375-.5375.2952 0 .5375.24.5375.5375zm-3.9405 0c0-1.879 1.5239-3.4029 3.4005-3.4029 1.879 0 3.4005 1.5215 3.4005 3.4029 0 1.879-1.5239 3.4005-3.4005 3.4005S8.6151 13.861 8.6151 11.982zm.1488 0c.0048 1.7974 1.4567 3.2493 3.2517 3.2517 1.795 0 3.254-1.4567 3.254-3.2517-.0023-1.7974-1.4566-3.2517-3.254-3.254-1.795 0-3.2517 1.4566-3.2517 3.254Z"/></svg>
										</a>
									)}
									{artistInfo.links.spotify && (
										<a href={artistInfo.links.spotify} target="_blank" rel="noopener noreferrer" aria-label="Spotify">
											<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>
										</a>
									)}
									{artistInfo.links.apple && (
										<a href={artistInfo.links.apple} target="_blank" rel="noopener noreferrer" aria-label="Apple Music">
											<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23.994 6.124a9.23 9.23 0 00-.24-2.19c-.317-1.31-1.062-2.31-2.18-3.043a5.022 5.022 0 00-1.877-.726 10.496 10.496 0 00-1.564-.15c-.04-.003-.083-.01-.124-.013H5.986c-.152.01-.303.017-.455.026-.747.043-1.49.123-2.193.4-1.336.53-2.3 1.452-2.865 2.78-.192.448-.292.925-.363 1.408-.056.392-.088.785-.1 1.18 0 .032-.007.062-.01.093v12.223c.01.14.017.283.027.424.05.815.154 1.624.497 2.373.65 1.42 1.738 2.353 3.234 2.801.42.127.856.187 1.293.228.555.053 1.11.06 1.667.06h11.03a12.5 12.5 0 001.57-.1c.822-.106 1.596-.35 2.295-.81a5.046 5.046 0 001.88-2.207c.186-.42.293-.87.37-1.324.113-.675.138-1.358.137-2.04-.002-3.8 0-7.595-.003-11.393zm-6.423 3.99v5.712c0 .417-.058.827-.244 1.206-.29.59-.76.962-1.388 1.14-.35.1-.706.157-1.07.173-.95.045-1.773-.6-1.943-1.536a1.88 1.88 0 011.038-2.022c.323-.16.67-.25 1.018-.324.378-.082.758-.153 1.134-.24.274-.063.457-.23.51-.516a.904.904 0 00.02-.193c0-1.815 0-3.63-.002-5.443a.725.725 0 00-.026-.185c-.04-.15-.15-.243-.304-.234-.16.01-.318.035-.475.066-.76.15-1.52.303-2.28.456l-2.325.47-1.374.278c-.016.003-.032.01-.048.013-.277.077-.377.203-.39.49-.002.042 0 .086 0 .13-.002 2.602 0 5.204-.003 7.805 0 .42-.047.836-.215 1.227-.278.64-.77 1.04-1.434 1.233-.35.1-.71.16-1.075.172-.96.036-1.755-.6-1.92-1.544-.14-.812.23-1.685 1.154-2.075.357-.15.73-.232 1.108-.31.287-.06.575-.116.86-.177.383-.083.583-.323.6-.714v-.15c0-2.96 0-5.922.002-8.882 0-.123.013-.25.042-.37.07-.285.273-.448.546-.518.255-.066.515-.112.774-.165.733-.15 1.466-.296 2.2-.444l2.27-.46c.67-.134 1.34-.27 2.01-.403.22-.043.442-.088.663-.106.31-.025.523.17.554.482.008.073.012.148.012.223.002 1.91.002 3.822 0 5.732z"/></svg>
										</a>
									)}
									{artistInfo.links.lastfm && (
										<a href={artistInfo.links.lastfm} target="_blank" rel="noopener noreferrer" aria-label="Last.fm">
											<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10.584 17.21l-.88-2.392s-1.43 1.594-3.573 1.594c-1.897 0-3.244-1.649-3.244-4.288 0-3.382 1.704-4.591 3.381-4.591 2.42 0 3.189 1.567 3.849 3.574l.88 2.749c.88 2.666 2.529 4.81 7.285 4.81 3.409 0 5.718-1.044 5.718-3.793 0-2.227-1.265-3.381-3.63-3.931l-1.758-.385c-1.21-.275-1.567-.77-1.567-1.595 0-.934.742-1.484 1.952-1.484 1.32 0 2.034.495 2.144 1.677l2.749-.33c-.22-2.474-1.924-3.492-4.729-3.492-2.474 0-4.893.935-4.893 3.932 0 1.87.907 3.051 3.189 3.601l1.87.44c1.402.33 1.869.907 1.869 1.704 0 1.017-.99 1.43-2.86 1.43-2.776 0-3.93-1.457-4.59-3.464l-.907-2.75c-1.155-3.573-2.997-4.893-6.653-4.893C2.144 5.333 0 7.89 0 12.233c0 4.18 2.144 6.434 5.993 6.434 3.106 0 4.591-1.457 4.591-1.457z"/></svg>
										</a>
									)}
								</p>
							)}
						</div>
					)
				}
				{
					links.length > 0 && (
						<div class="links">
							{links.map((l) => (
								<a class="btn" href={l.href} target="_blank" rel="noopener noreferrer">
									{l.label}
								</a>
							))}
						</div>
					)
				}
			</div>

			<div class="right">
				{!artistInfo && <p class="eyebrow">{kindLabel}</p>}
				<h1>{title}</h1>
				{
					subtitle && (
						<p class="sub">
							{subtitleHref ? <a href={subtitleHref}>{subtitle}</a> : subtitle}
						</p>
					)
				}
				<ul class="kstats">
					{
						stats.map((s) => (
							<li>
								<span class="v">{s.v}</span>
								<span class="k">{s.k}</span>
							</li>
						))
					}
				</ul>

				{values.some((v) => v > 0) && (
					<section class="yearly">
						<div class="section-head">
							<h2>Yıllara göre</h2>
							<span class="more muted">çalma sayısı</span>
						</div>
						<MusicBars values={values} labels={labels} aria={`${title} — yıllık çalma`} />
					</section>
				)}

				<slot />
			</div>
		</div>
	</div>
</article>

<style>
	.mdet {
		padding-block: 1.5rem 0;
	}
	.crumbs {
		display: flex;
		gap: 0.5rem;
		font-family: var(--font-head);
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-muted);
		margin-bottom: 1.5rem;
	}
	.crumbs a {
		color: var(--text-muted);
	}
	.crumbs a:hover {
		color: var(--link-hover);
	}

	.cols {
		display: grid;
		grid-template-columns: minmax(200px, 280px) 1fr;
		gap: clamp(1.5rem, 4vw, 3rem);
		align-items: start;
	}
	.left {
		--poster-max: 280px;
		position: sticky;
		top: clamp(8rem, 6vw, 8.5rem);
	}

	.left :global(.mcover) {
		border: 1px solid var(--border-strong);
		background: var(--surface);
		box-shadow: var(--shadow);
	}
	/* Sanatçı adı: sol kolondaki görselin üstünde (above), ortalanmış. */
	.artist-title {
		margin: 0 0 0.7rem;
		font-family: var(--font-display);
		font-weight: var(--headline-weight);
		letter-spacing: var(--headline-tracking);
		text-align: center;
		font-size: clamp(1.3rem, 0.9rem + 1.8vw, 2rem);
		line-height: 1.15;
		text-transform: lowercase;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
		margin-top: 1rem;
	}

	/* sanatçı ek bilgisi: tür · ülke · dış bağlantılar */
	.ainfo {
		margin-top: 0.9rem;
		text-align: center;
		font-family: var(--font-meta);
		font-size: 0.85rem;
		line-height: 1.5;
		color: var(--text-muted);
	}
	.ainfo p {
		margin: 0.18rem 0;
	}
	.a-genres {
		list-style: none;
		margin: 0.2rem 0 0.45rem;
		padding: 0;
		color: var(--text);
	}
	.a-genres li {
		display: block;
		line-height: 1.4;
	}
	.a-genres a {
		color: inherit;
		text-decoration: none;
	}
	.a-genres a:hover {
		color: var(--link-hover);
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.a-country {
		font-size: 0.8rem;
		color: var(--text-faint);
	}
	.a-country a {
		color: inherit;
		text-decoration: none;
	}
	.a-country a:hover {
		color: var(--link-hover);
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.a-links {
		font-size: 0.8rem;
	}
	.a-links a {
		color: var(--text-muted);
	}
	.a-links a:hover {
		color: var(--link-hover);
	}
	.a-icons {
		/* İkon boyutu görünüme göre ölçeklenir; üst sınır 38px. */
		--icon-size: clamp(1.875rem, 1vw + 1.875rem, 2.375rem);
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 0.75rem;
	}
	.a-icons a {
		display: inline-flex;
		color: var(--text-muted);
		transition: color var(--dur) var(--ease);
	}
	.a-icons a:hover {
		color: var(--link-hover);
	}
	.a-icons svg {
		width: var(--icon-size);
		height: var(--icon-size);
		fill: currentColor;
	}

	/* sanatçı sayfası: sol blok (görsel + veriler) ve sağ blok
	   anasayfadaki .panel görünümünde ayrı birer arka plan alır */
	.mdet-artist .cols {
		grid-template-columns: minmax(220px, 340px) 1fr;
	}
	.mdet-artist .left,
	.mdet-artist .right {
		background: var(--surface);
		border-radius: 14px;
		box-shadow: var(--shadow);
		padding: clamp(1.15rem, 2.6vw, 1.85rem) clamp(1.15rem, 3vw, 2.25rem)
			clamp(1.4rem, 3vw, 2.25rem);
	}
	.mdet-artist .left :global(.mcover) {
		background: var(--bg-2);
	}

	.eyebrow + h1 {
		margin-top: 0.2rem;
	}
	.sub {
		margin: -0.4rem 0 0;
		font-family: var(--font-card);
		font-size: 1.2rem;
		color: var(--text-muted);
	}
	.sub a:hover {
		color: var(--link-hover);
	}

	.kstats {
		list-style: none;
		margin: 1.4rem 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
		gap: 0.9rem 1.5rem;
	}
	.kstats li {
		display: flex;
		flex-direction: column;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid var(--border);
	}
	.kstats .v {
		font-family: var(--font-card);
		font-size: 1.4rem;
		line-height: 1.15;
	}
	.kstats .k {
		font-family: var(--font-ui);
		font-size: 0.66rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-faint);
	}

	.yearly {
		margin-top: clamp(2rem, 5vw, 3rem);
	}

	@media (max-width: 760px) {
		.cols,
		.mdet-artist .cols {
			grid-template-columns: 1fr;
		}
		.left {
			position: static;
			width: 100%;
			max-width: 100%;
		}
		.left :global(.mcover) {
			width: 100%;
			max-width: 100%;
		}
		.mdet-artist .left {
			position: static;
			width: 100%;
			max-width: 100%;
		}
		.mdet-artist .left :global(.frame),
		.mdet-artist .left :global(.mcover) {
			width: 100%;
			max-width: 100%;
		}
		.a-icons {
			--icon-size: clamp(1.6rem, 3vw + 0.625rem, 2rem);
			gap: 0.5rem;
		}
	}
</style>
