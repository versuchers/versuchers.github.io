---
interface Props {
	values: number[];
	labels: string[];
	aria: string;
}

const { values, labels, aria } = Astro.props;

const W = 760;
const H = 190;
const mL = 10;
const mR = 10;
const mT = 24;
const mB = 30;
const max = Math.max(...values, 1);
const n = values.length;
const innerW = W - mL - mR;
const innerH = H - mT - mB;
const step = innerW / n;
const bw = Math.min(46, step * 0.62);
const fmt = (x: number) => Math.round(x).toLocaleString('tr-TR');

const shape = values.map((v, i) => {
	const h = Math.max(1, (v / max) * innerH);
	const x = mL + step * i + (step - bw) / 2;
	const y = mT + innerH - h;
	return { v, h, x, y };
});
---

<svg viewBox={`0 0 ${W} ${H}`} class="chart" role="img" aria-label={aria}>
	{
		shape.map((s, i) => (
			<>
				<rect class="bar" x={s.x.toFixed(1)} y={s.y.toFixed(1)} width={bw.toFixed(1)} height={s.h.toFixed(1)} rx="3" />
				{s.v > 0 && (
					<text class="val" x={(s.x + bw / 2).toFixed(1)} y={(s.y - 5).toFixed(1)} text-anchor="middle">
						{fmt(s.v)}
					</text>
				)}
				<text class="lbl" x={(s.x + bw / 2).toFixed(1)} y={H - 10} text-anchor="middle">
					{labels[i]}
				</text>
			</>
		))
	}
</svg>

<style>
	.chart {
		width: 100%;
		height: auto;
		display: block;
		overflow: visible;
	}
	.bar {
		fill: var(--accent);
	}
	.val {
		fill: var(--text-muted);
		font-family: var(--font-ui);
		font-size: 11px;
	}
	.lbl {
		fill: var(--text-faint);
		font-family: var(--font-ui);
		font-size: 11px;
	}
</style>
