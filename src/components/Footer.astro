---
const year = new Date().getFullYear();
const links = [
	{ label: 'Filmler', href: '/film' },
	{ label: 'Diziler', href: '/dizi' },
	{ label: 'Kitaplar', href: '/kitap' },
];
---

<footer class="site-footer">
	<div class="container inner">
		<div class="col">
			<p class="brand">Versucher</p>
			<p class="muted small">
				İzlediklerim, okuduklarım ve dinlediklerim. Veriler Google Sheets ve Spotify
				geçmişimden gelir; burada görselleştirilir.
			</p>
		</div>

		<div class="col">
			<p class="eyebrow">Arşiv</p>
			<ul>
				{
					links.map((s) => (
						<li>
							<a href={s.href}>{s.label}</a>
						</li>
					))
				}
			</ul>
		</div>

		<div class="col">
			<p class="eyebrow">Diğer</p>
			<ul>
				<li><a href="/blog">Blog</a></li>
				<li><a href="/playlist">Playlistler</a></li>
				<li><a href="/hakkimda">Hakkımda</a></li>
			</ul>
		</div>

		<div class="col">
			<p class="eyebrow">Sayılar</p>
			<ul>
				<li><a href="/sayilar/">Toplu</a></li>
				<li><a href="/sayilar/izleme/">İzleme</a></li>
				<li><a href="/sayilar/film/">Film</a></li>
				<li><a href="/sayilar/dizi/">Dizi</a></li>
				<li><a href="/sayilar/kitap/">Kitap</a></li>
			</ul>
		</div>
	</div>

	<div class="container bottom">
		<span class="muted small">© {year} · versucher.com</span>
		<span class="muted small">Astro ile üretildi</span>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: clamp(3rem, 8vw, 6rem);
		border-top: 1px solid var(--border);
		padding-block: clamp(2rem, 5vw, 3rem) 2rem;
		background: var(--bg-2);
	}

	.inner {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr 1fr;
		gap: 2rem;
	}

	.brand {
		font-family: var(--font-display);
		font-weight: 400;
		font-size: 1.2rem;
		letter-spacing: 0.14em;
		text-transform: lowercase;
		margin: 0 0 0.5rem;
	}

	.small {
		font-size: 0.85rem;
	}

	/* Bağlantı kolonları (Arşiv / Diğer / Sayılar) Manrope kullanır. */
	.col:not(:first-child) {
		font-family: var(--font-ui);
	}

	.col ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.4rem;
	}

	.col a {
		font-family: var(--font-ui);
		font-size: 0.76rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--text-muted);
	}
	.col a:hover {
		color: var(--link-hover);
	}

	.bottom {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		margin-top: 2.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--border);
		flex-wrap: wrap;
	}

	@media (max-width: 720px) {
		.inner {
			grid-template-columns: 1fr 1fr;
		}
		.col:first-child {
			grid-column: 1 / -1;
		}
	}
</style>
