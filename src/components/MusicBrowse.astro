---
import MusicCover from './MusicCover.astro';
import { integer } from '../lib/music';

export interface BrowseRow {
	href: string;
	title: string;
	sub?: string;
	src?: string;
	round?: boolean;
	plays: number;
}

interface Props {
	label: string;
	unit: string;
	/** Arama indeksi adresi (/search-index/*.json); yalnızca arama yapılınca çekilir. */
	indexUrl?: string;
	rows: BrowseRow[];
}

const { label, unit, indexUrl, rows } = Astro.props;
---

<div class="mbrowse" data-mbrowse data-unit={unit} data-index={indexUrl}>
	<div class="controls">
		<label class="search">
			<span class="visually-hidden">{label} içinde ara</span>
			<span class="icon" aria-hidden="true">⌕</span>
			<input type="search" data-f="search" placeholder={`${label} içinde ara…`} autocomplete="off" />
		</label>
		<label class="field">
			<span>Sırala</span>
			<select data-f="sort">
				<option value="plays">Çalmaya göre (çok→az)</option>
				<option value="title">Ada göre (A→Z)</option>
			</select>
		</label>
		<button type="button" class="btn reset" data-f="reset">Sıfırla</button>
	</div>

	<div class="status">
		<span data-count class="muted">{rows.length} {unit}</span>
	</div>

	<ol class="mrow-list">
		{
			rows.map((r, i) => (
				<li class="mrow" data-title={r.title.toLocaleLowerCase('tr')} data-plays={String(r.plays)}>
					<span class="rk">{i + 1}</span>
					<a class="row-link" href={r.href}>
						<MusicCover src={r.src} alt="" name={r.title} round={r.round} />
						<span class="txt">
							<span class="t">{r.title}</span>
							{r.sub && <span class="s muted">{r.sub}</span>}
						</span>
						<span class="plays">
							<strong>{integer(r.plays)}</strong>
							<span>çalma</span>
						</span>
					</a>
				</li>
			))
		}
	</ol>

	<div class="more-wrap">
		<button type="button" class="btn" data-more hidden>Daha fazla göster</button>
	</div>

	<p class="empty muted" data-empty hidden>Aramanla eşleşen kayıt yok.</p>
</div>

<script>
	import { fold } from '../lib/text';

	/** Her seferinde gösterilecek kayıt sayısı. */
	const PAGE = 66;

	document.querySelectorAll<HTMLElement>('[data-mbrowse]').forEach((root) => {
		const list = root.querySelector<HTMLElement>('.mrow-list');
		if (!list) return;

		const els = Array.from(list.children) as HTMLElement[];
		const position = new Map<HTMLElement, number>();
		els.forEach((el, i) => position.set(el, i));

		const search = root.querySelector<HTMLInputElement>('[data-f="search"]')!;
		const sort = root.querySelector<HTMLSelectElement>('[data-f="sort"]')!;
		const reset = root.querySelector<HTMLButtonElement>('[data-f="reset"]')!;
		const count = root.querySelector<HTMLElement>('[data-count]')!;
		const empty = root.querySelector<HTMLElement>('[data-empty]')!;
		const more = root.querySelector<HTMLButtonElement>('[data-more]');
		const unit = root.dataset.unit || '';
		const indexUrl = root.dataset.index || '';

		let loaded: string[] | null = null;
		let loading: Promise<string[]> | null = null;
		let matches: Set<HTMLElement> = new Set(els);
		let searching = false;
		let shown = PAGE;

		/** Arama metinlerini (gerekiyorsa ve yalnızca bir kez) ağdan getirir. */
		function loadIndex(): Promise<string[]> {
			if (loaded) return Promise.resolve(loaded);
			if (loading) return loading;
			if (!indexUrl) {
				loaded = [];
				return Promise.resolve(loaded);
			}
			loading = fetch(indexUrl)
				.then((r) => (r.ok ? r.json() : []))
				.then((arr: unknown) => (loaded = Array.isArray(arr) ? (arr as string[]) : []))
				.catch(() => (loaded = []));
			return loading;
		}

		/** Seçili sıralamaya göre öğe sırası. */
		function sortedEls(): HTMLElement[] {
			const mode = sort.value;
			return [...els].sort((a, b) => {
				if (mode === 'title')
					return (a.dataset.title || '').localeCompare(b.dataset.title || '', 'tr');
				return Number(b.dataset.plays || 0) - Number(a.dataset.plays || 0);
			});
		}

		/** Arama + sıralama + sayfalamayı ekrana uygular. */
		function render() {
			const order = sortedEls();
			const matched = order.filter((el) => matches.has(el));
			const limit = searching ? matched.length : Math.min(shown, matched.length);
			const visible = new Set(matched.slice(0, limit));

			let rank = 0;
			const frag = document.createDocumentFragment();
			for (const el of order) {
				const show = visible.has(el);
				el.hidden = !show;
				if (show) {
					rank += 1;
					const rk = el.querySelector<HTMLElement>('.rk');
					if (rk) rk.textContent = String(rank);
				}
				frag.appendChild(el);
			}
			list!.appendChild(frag);

			count.textContent = `${matched.length} ${unit}`;
			empty.hidden = matched.length !== 0;

			if (more) {
				const remaining = matched.length - limit;
				more.hidden = searching || remaining <= 0;
				more.textContent = `Daha fazla göster (${remaining} kaldı)`;
			}
		}

		async function onSearch() {
			const q = fold(search.value.trim());
			searching = q.length > 0;
			if (!searching) {
				matches = new Set(els);
				render();
				return;
			}
			const index = await loadIndex();
			matches = new Set(els.filter((el) => (index[position.get(el) ?? -1] || '').includes(q)));
			render();
		}

		search.addEventListener('input', () => void onSearch());
		sort.addEventListener('change', render);
		more?.addEventListener('click', () => {
			shown += PAGE;
			render();
		});
		reset.addEventListener('click', () => {
			search.value = '';
			sort.value = 'plays';
			matches = new Set(els);
			searching = false;
			shown = PAGE;
			render();
		});

		render();
	});
</script>

<style>
	.mbrowse .controls {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem;
		margin-bottom: 1rem;
	}
	.mbrowse .search {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex: 1 1 240px;
		min-width: 200px;
		padding: 0 0.85rem;
		height: 2.6rem;
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-sm);
		background: var(--surface);
	}
	.mbrowse .search .icon {
		color: var(--text-faint);
		font-size: 1.05rem;
	}
	.mbrowse .search input {
		border: 0;
		background: transparent;
		color: var(--text);
		width: 100%;
		height: 100%;
		font-family: var(--font-ui);
		font-size: 0.95rem;
		outline: none;
	}
	.mbrowse .field {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-ui);
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-faint);
	}
	.mbrowse select {
		height: 2.6rem;
		padding: 0 0.6rem;
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-sm);
		background: var(--surface);
		color: var(--text);
		font-family: var(--font-ui);
		font-size: 0.85rem;
	}
	.mbrowse .btn {
		height: 2.6rem;
	}
	.mbrowse .status {
		margin-bottom: 0.75rem;
		font-size: 0.85rem;
	}
	.mbrowse .mrow-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.mbrowse .mrow {
		content-visibility: auto;
		contain-intrinsic-size: auto 66px;
		border-top: 1px solid var(--border);
	}
	.mbrowse .mrow[hidden] {
		display: none;
	}
	.mbrowse .row-link {
		display: grid;
		grid-template-columns: 2rem 48px 1fr auto;
		align-items: center;
		gap: 0.9rem;
		padding: 0.55rem 0.4rem;
		color: inherit;
		text-decoration: none;
	}
	.mbrowse .row-link:hover {
		background: var(--surface-2);
	}
	.mbrowse .rk {
		font-family: var(--font-ui);
		font-size: 0.78rem;
		color: var(--text-faint);
		text-align: right;
	}
	.mbrowse .txt {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}
	.mbrowse .t {
		font-family: var(--font-card);
		font-size: 1.05rem;
		line-height: 1.25;
	}
	.mbrowse .s {
		font-family: var(--font-meta);
		font-size: 0.85rem;
		line-height: 1.3;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.mbrowse .plays {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		font-family: var(--font-ui);
		font-size: 0.62rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-faint);
	}
	.mbrowse .plays strong {
		font-size: 1.05rem;
		font-weight: 600;
		letter-spacing: 0;
		color: var(--text);
	}
	.mbrowse .more-wrap {
		display: flex;
		justify-content: center;
		margin-top: 1.5rem;
	}
	.mbrowse .empty {
		margin-top: 1rem;
	}

	@media (max-width: 520px) {
		.mbrowse .row-link {
			grid-template-columns: 1.4rem 44px 1fr auto;
			gap: 0.7rem;
		}
	}
</style>
