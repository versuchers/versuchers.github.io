---
import MusicCover from './MusicCover.astro';
import { integer } from '../lib/music';

export interface BrowseRow {
	/** Detay sayfası yoksa (ör. türler) boş bırakılır. */
	href?: string;
	title: string;
	sub?: string;
	src?: string;
	round?: boolean;
	plays: number;
}

interface Props {
	label: string;
	unit: string;
	/** Arama indeksi adresi (/search-index/*.json); yalnızca arama yapılınca çekilir. */
	indexUrl?: string;
	rows: BrowseRow[];
	/** Kategori: sanatci|sarki|album */
	kat?: string;
	/** Liste sayfası base URL */
	baseUrl?: string;
	/** Yıllar dizisi */
	years?: number[];
}

const { label, unit, indexUrl, rows, kat, baseUrl, years = [] } = Astro.props;
---

<div class="mbrowse" data-mbrowse data-unit={unit} data-index={indexUrl} data-kat={kat} data-base={baseUrl}>
	<div class="controls">
		<label class="search">
			<span class="visually-hidden">{label} içinde ara</span>
			<span class="icon" aria-hidden="true">⌕</span>
			<input type="search" data-f="search" placeholder={`${label} içinde ara…`} autocomplete="off" />
		</label>
		<label class="field">
			<span>Sırala</span>
			<select data-f="sort">
				<option value="plays">Çalmaya göre (çok→az)</option>
				<option value="title">Ada göre (A→Z)</option>
			</select>
		</label>
		<button type="button" class="btn reset" data-f="reset">Sıfırla</button>
	</div>

	<div class="mbrowse-tabs" role="group" aria-label="Yıl seçimi">
		<button type="button" class="mbrowse-tab is-on" data-yil="" aria-pressed="true">Tümü</button>
		{years.map((y) => <button type="button" class="mbrowse-tab" data-yil={String(y)} aria-pressed="false">{y}</button>)}
	</div>
	<div class="status">
		<span data-count class="muted">{rows.length} {unit}</span>
	</div>

	<ol class="mrow-list">
		{
			rows.map((r, i) => (
				<li class="mrow" data-title={r.title.toLocaleLowerCase('tr')} data-plays={String(r.plays)}>
					<span class="rk">{i + 1}</span>
					<a class="row-link" href={r.href}>
						<MusicCover src={r.src} alt="" name={r.title} round={r.round} />
						<span class="txt">
							<span class="t">{r.title}</span>
							{r.sub && <span class="s muted">{r.sub}</span>}
						</span>
						<span class="plays">
							<strong>{integer(r.plays)}</strong>
							<span>çalma</span>
						</span>
					</a>
				</li>
			))
		}
	</ol>

	<div class="more-wrap">
		<button type="button" class="btn" data-more hidden>Daha fazla göster</button>
	</div>

	<p class="empty muted" data-empty hidden>Aramanla eşleşen kayıt yok.</p>
</div>

<script>
	import { fold } from '../lib/text';
	declare const window: any;

	/** Her seferinde gösterilecek kayıt sayısı. */
	const PAGE = 66;

	document.querySelectorAll<HTMLElement>('[data-mbrowse]').forEach((root) => {
		const list = root.querySelector<HTMLElement>('.mrow-list');
		if (!list) return;

		let els = Array.from(list.children) as HTMLElement[];
		const position = new Map<HTMLElement, number>();
		els.forEach((el, i) => position.set(el, i));
		// Kapsayıcı Astro stilleri: yıl satırları bu şablondan klonlanır ki
		// data-astro-cid öznitelikleri korunsun ve stiller uygulansın.
		const rowTemplate = list.querySelector<HTMLElement>('.mrow')?.cloneNode(true) as HTMLElement | undefined;

		const search = root.querySelector<HTMLInputElement>('[data-f="search"]')!;
		const sort = root.querySelector<HTMLSelectElement>('[data-f="sort"]')!;
		const reset = root.querySelector<HTMLButtonElement>('[data-f="reset"]')!;
		const count = root.querySelector<HTMLElement>('[data-count]')!;
		const empty = root.querySelector<HTMLElement>('[data-empty]')!;
		const more = root.querySelector<HTMLButtonElement>('[data-more]');
		const unit = root.dataset.unit || '';
		const indexUrl = root.dataset.index || '';
		const kat = root.dataset.kat || '';
		const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('.mbrowse-tab'));
		/** Yıl görünimindeyken arama, indeks yerine doğrudan satır başlıklarına yapılır. */
		const inYearView = () => yearRows !== null;

		let loaded: string[] | null = null;
		let loading: Promise<string[]> | null = null;
		let matches: Set<HTMLElement> = new Set(els);
		let searching = false;
		let shown = PAGE;
		// script ayrı bir modül olduğu için frontmatter'daki BrowseRow görünmez
		type YearRow = { title: string; sub?: string; plays: number; href?: string; src?: string; round?: boolean };
		let yearRows: YearRow[] | null = null;
		/** Klonlanan elemana referans elemanın Astro kapsam özniteliklerini kopyalar. */
		const stamp = (el: Element, ref: Element) => {
			for (const a of ref.attributes) if (a.name.startsWith('data-astro-cid')) el.setAttribute(a.name, a.value);
		};
		function buildYearRows(rows: YearRow[]) {
			if (!rowTemplate) return;
			const frag = document.createDocumentFragment();
			for (let i = 0; i < rows.length; i++) {
				const r = rows[i];
				const li = rowTemplate.cloneNode(true) as HTMLElement;
				li.setAttribute('data-title', (r.title || '').toLocaleLowerCase('tr'));
				li.setAttribute('data-plays', String(r.plays || 0));
				const rk = li.querySelector<HTMLElement>('.rk');
				if (rk) rk.textContent = String(i + 1);
				const link = li.querySelector<HTMLAnchorElement>('.row-link');
				if (link) {
					// detay sayfası yoksa satır bağlantısız
					if (r.href) link.setAttribute('href', r.href);
					else link.removeAttribute('href');
				}
				const title = li.querySelector<HTMLElement>('.t');
				if (title) title.textContent = r.title || '(isimsiz)';
				let sub = li.querySelector<HTMLElement>('.s');
				if (r.sub) {
					if (!sub && title) {
						sub = document.createElement('span');
						sub.className = 's muted';
						stamp(sub, title);
						title.parentElement?.append(sub);
					}
					if (sub) sub.textContent = r.sub;
				} else if (sub) {
					sub.remove();
				}
				const plays = li.querySelector<HTMLElement>('.plays strong');
				if (plays) plays.textContent = Math.round(r.plays).toLocaleString('tr-TR');
				const fig = li.querySelector<HTMLElement>('.mcover');
				if (fig) fig.classList.toggle('round', Boolean(r.round));
				const mono = fig?.querySelector<HTMLElement>('.mono');
				if (mono) mono.textContent = Array.from((r.title || '').trim())[0]?.toLocaleUpperCase('tr') || '?';
				let img = fig?.querySelector<HTMLImageElement>('img');
				if (r.src) {
					if (!img && fig && mono) {
						img = document.createElement('img');
						img.alt = '';
						img.loading = 'lazy';
						img.decoding = 'async';
						img.referrerPolicy = 'no-referrer';
						img.dataset.coverImg = '';
						const created = img;
						created.onload = () => { created.dataset.loaded = ''; };
						created.onerror = () => created.remove();
						stamp(img, mono);
						fig.append(img);
					}
					if (img) {
						delete img.dataset.loaded;
						img.setAttribute('src', r.src);
					}
				} else if (img) {
					img.remove();
				}
				frag.append(li);
			}
			list!.replaceChildren(frag);
		}
		const cache = new Map<string, any[]>();
		async function fetchYear(yil: string) {
			if (cache.has(yil)) return cache.get(yil)!;
			try {
				const res = await fetch(`/data/muzik/yil/${yil}-${kat}.json`);
				const data = await res.json() as { items: Array<{name:string,sub?:string,plays:number,href:string|null,img:string|null}> };
				// tür listesinde sıralama = ekrandaki çalma sayısı; eşitlikte ad A→Z
				if (kat === 'tur') data.items.sort((a, b) => b.plays - a.plays || a.name.localeCompare(b.name, 'tr'));
				cache.set(yil, data.items.map(x => ({title: x.name, sub: x.sub, plays: x.plays, href: x.href ?? '', src: x.img ?? undefined, round: kat === 'sanatci'})));
				return cache.get(yil)!;
			} catch {
				cache.set(yil, []);
				return [];
			}
		}
		/* decl moved */
		/** Arama metinlerini (gerekiyorsa ve yalnızca bir kez) ağdan getirir. */
		function loadIndex(): Promise<string[]> {
			if (loaded) return Promise.resolve(loaded);
			if (loading) return loading;
			if (!indexUrl) {
				loaded = [];
				return Promise.resolve(loaded);
			}
			loading = fetch(indexUrl)
				.then((r) => (r.ok ? r.json() : []))
				.then((arr: unknown) => (loaded = Array.isArray(arr) ? (arr as string[]) : []))
				.catch(() => (loaded = []));
			return loading;
		}

		/** Seçili sıralamaya göre öğe sırası. */
		function sortedEls(): HTMLElement[] {
			const mode = sort.value;
			return [...els].sort((a, b) => {
				if (mode === 'title')
					return (a.dataset.title || '').localeCompare(b.dataset.title || '', 'tr');
				return Number(b.dataset.plays || 0) - Number(a.dataset.plays || 0);
			});
		}

		/** Arama + sıralama + sayfalamayı ekrana uygular. */
		function render() {
			const order = sortedEls();
			const matched = order.filter((el) => matches.has(el));
			const limit = searching ? matched.length : Math.min(shown, matched.length);
			const visible = new Set(matched.slice(0, limit));

			let rank = 0;
			const frag = document.createDocumentFragment();
			for (const el of order) {
				const show = visible.has(el);
				el.hidden = !show;
				if (show) {
					rank += 1;
					const rk = el.querySelector<HTMLElement>('.rk');
					if (rk) rk.textContent = String(rank);
				}
				frag.appendChild(el);
			}
			list!.appendChild(frag);

			count.textContent = `${matched.length} ${unit}`;
			empty.hidden = matched.length !== 0;

			if (more) {
				const remaining = matched.length - limit;
				more.hidden = searching || remaining <= 0;
				more.textContent = `Daha fazla göster (${remaining} kaldı)`;
			}
		}

		async function onSearch() {
			const q = fold(search.value.trim());
			searching = q.length > 0;
			if (!searching) {
				matches = new Set(els);
				render();
				return;
			}
			const index = await loadIndex();
			matches = yearRows || !indexUrl
				// yıl görünümü / indeks yok: doğrudan satır başlıklarında ara
				? new Set(els.filter((el) => fold(el.dataset.title || '').includes(q)))
				: new Set(els.filter((el) => (index[position.get(el) ?? -1] || '').includes(q)));
			render();
		}

		search.addEventListener('input', () => void onSearch());
		sort.addEventListener('change', render);
		more?.addEventListener('click', () => {
			shown += PAGE;
			render();
		});
		reset.addEventListener('click', async () => {
			search.value = '';
			sort.value = 'plays';
			for (const b of tabs) { const on = b.dataset.yil === ''; b.classList.toggle('is-on', on); b.setAttribute('aria-pressed', String(on)); }
			yearRows = null;
			if ((window as any).__mbrowseOrig) {
				list.querySelectorAll('.mrow').forEach(x => x.remove());
				const temp = document.createElement('div');
				temp.innerHTML = (window as any).__mbrowseOrig;
				while (temp.firstChild) list!.appendChild(temp.firstChild);
			}
			els = Array.from(list.querySelectorAll<HTMLElement>('.mrow'));
			position.clear();
			els.forEach((el,i)=>position.set(el,i));
			matches = new Set(els);
			searching = false;
			shown = PAGE;
			render();
		});

		render();
		if (!(window as any).__mbrowseOrig) (window as any).__mbrowseOrig = list.innerHTML;
		for (const tab of tabs) {
			tab.addEventListener('click', async () => {
				for (const b of tabs) { b.classList.toggle('is-on', b === tab); b.setAttribute('aria-pressed', String(b === tab)); }
				const yil = tab.dataset.yil || '';
				if (!yil) {
					yearRows = null;
					if ((window as any).__mbrowseOrig) {
						list.querySelectorAll('.mrow').forEach(x => x.remove());
						const temp = document.createElement('div');
						temp.innerHTML = (window as any).__mbrowseOrig;
						while (temp.firstChild) list!.appendChild(temp.firstChild);
					}
				} else {
					yearRows = await fetchYear(yil);
					buildYearRows(yearRows);
				}
				els = Array.from(list.querySelectorAll<HTMLElement>('.mrow'));
				position.clear();
				els.forEach((el, i) => position.set(el, i));
				matches = new Set(els);
				searching = false;
				search.value = '';
				// yıl görünümünde listenin tamamı (ilk 100) görünsün
				shown = yearRows ? yearRows.length : PAGE;
				// seçili yılı adrese yaz (Tümü = ?yil'siz)
				const url = new URL(location.href);
				if (yil) url.searchParams.set('yil', yil);
				else url.searchParams.delete('yil');
				history.replaceState(null, '', url);
				render();
			});
		}

		// ?yil=2019 gibi bir adresle gelindiyse o sekme açılışta seçilir
		const initYil = new URL(location.href).searchParams.get('yil') || '';
		if (initYil) tabs.find((t) => t.dataset.yil === initYil)?.click();
	});
</script>

<style>
	.mbrowse .controls {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem;
		margin-bottom: 1rem;
	}
	.mbrowse .search {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex: 1 1 240px;
		min-width: 200px;
		padding: 0 0.85rem;
		height: 2.6rem;
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-sm);
		background: var(--surface);
	}
	.mbrowse .search .icon {
		color: var(--text-faint);
		font-size: 1.05rem;
	}
	.mbrowse .search input {
		border: 0;
		background: transparent;
		color: var(--text);
		width: 100%;
		height: 100%;
		font-family: var(--font-ui);
		font-size: 0.95rem;
		outline: none;
	}
	.mbrowse .field {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-ui);
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-faint);
	}
	.mbrowse select {
		height: 2.6rem;
		padding: 0 0.6rem;
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-sm);
		background: var(--surface);
		color: var(--text);
		font-family: var(--font-ui);
		font-size: 0.85rem;
	}
	.mbrowse .btn {
		height: 2.6rem;
	}
	.mbrowse .status {
		margin-bottom: 0.75rem;
		font-size: 0.85rem;
	}
	.mbrowse .mrow-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.mbrowse .mrow {
		content-visibility: auto;
		contain-intrinsic-size: auto 66px;
		border-top: 1px solid var(--border);
		/* rk (sıra no) + satır: 2 sütun. rk, row-link'in kardeşi, içinde değil. */
		display: grid;
		grid-template-columns: 2rem 1fr;
		align-items: center;
		column-gap: 0.7rem;
	}
	.mbrowse .mrow[hidden] {
		display: none;
	}
	.mbrowse .row-link {
		display: grid;
		/* 3 çocuk: cover + txt + plays (rk dışarıda). */
		grid-template-columns: 48px 1fr auto;
		align-items: center;
		gap: 0.9rem;
		padding: 0.55rem 0.4rem;
		color: inherit;
		text-decoration: none;
	}
	.mbrowse .row-link:hover {
		background: var(--surface-2);
	}
	.mbrowse .rk {
		font-family: var(--font-ui);
		font-size: 0.78rem;
		color: var(--text-faint);
		text-align: right;
	}
	.mbrowse .txt {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}
	.mbrowse .t {
		font-family: var(--font-card);
		font-size: 1.05rem;
		line-height: 1.25;
	}
	.mbrowse .s {
		font-family: var(--font-meta);
		font-size: 0.85rem;
		line-height: 1.3;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.mbrowse .plays {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		font-family: var(--font-ui);
		font-size: 0.62rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-faint);
	}
	.mbrowse .plays strong {
		font-size: 1.05rem;
		font-weight: 600;
		letter-spacing: 0;
		color: var(--text);
	}
	.mbrowse .more-wrap {
		display: flex;
		justify-content: center;
		margin-top: 1.5rem;
	}
	.mbrowse .empty {
		margin-top: 1rem;
	}
	.mbrowse-tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 2px;
		margin-bottom: 0.8rem;
	}
	.mbrowse-tab {
		font-family: var(--font-ui);
		font-size: 0.66rem;
		letter-spacing: 0.04em;
		line-height: 1;
		padding: 0.28rem 0.5rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: transparent;
		color: var(--text-muted);
		cursor: pointer;
		transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
	}
	.mbrowse-tab:hover { color: var(--text); border-color: var(--border-strong); }
	.mbrowse-tab.is-on { color: var(--accent-2); border-color: var(--accent); background: var(--accent-soft); }


	@media (max-width: 520px) {
		.mbrowse .row-link {
			grid-template-columns: 44px 1fr auto;
			gap: 0.7rem;
		}
	}
</style>
