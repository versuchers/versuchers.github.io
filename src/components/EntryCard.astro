---
import { href, KIND_LABEL, type Entry } from '../lib/data';
import { formatYearRange } from '../lib/format';
import Poster from './Poster.astro';

interface Props {
	entry: Entry;
	/** Görseldeki tür rozeti gösterilsin mi? */
	showType?: boolean;
	eager?: boolean;
	/** Alt bilgi düzeyi: 'compact' → film yalnız yıl, dizi/kitap yalnız ad. */
	subMode?: 'full' | 'compact';
}

const {
	entry,
	showType = false,
	eager = false,
	subMode = 'full',
} = Astro.props;

const displayTitle = entry.type === 'film' ? entry.fullTitle || entry.title : entry.title;

// Alt satırda gösterilecek ikincil bilgi (tarih değil: yalnız yapım yılı / yazar).
let sub = '';
if (entry.type === 'film') {
	sub = formatYearRange(entry.year);
} else if (entry.type === 'dizi' && subMode === 'full') {
	sub = formatYearRange(entry.yearRange, entry.year);
}

const authorLine = entry.type === 'kitap' ? entry.author : '';
---

<a class="card entry-card" href={href(entry)}>
	<div class="poster-wrap">
		<Poster src={entry.poster} alt={displayTitle} kind={entry.type} eager={eager} />
		{showType && <span class="type-badge">{KIND_LABEL[entry.type]}</span>}
	</div>
	<div class="body">
		<h3 class="title" title={displayTitle}>{displayTitle}</h3>
		<p class="sub">
			{authorLine && <span class="author">{authorLine}</span>}
			{sub && <span class="year">{sub}</span>}
		</p>
	</div>
</a>

<style>
	.entry-card {
		display: flex;
		flex-direction: column;
		height: 100%;
		font-family: var(--font-card);
	}

	.poster-wrap {
		position: relative;
	}

	.type-badge {
		position: absolute;
		left: 0.5rem;
		top: 0.5rem;
		background: var(--accent);
		color: var(--accent-contrast);
		font-family: var(--font-card);
		font-size: 0.66rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		padding: 0.12rem 0.5rem;
		border-radius: 999px;
	}

	.body {
		padding: 0.7rem 0.8rem 0.85rem;
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	.title {
		font-family: var(--font-card);
		font-size: 1.05rem;
		margin: 0;
		line-height: 1.3;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.sub {
		margin: 0;
		font-size: 0.8rem;
		color: var(--text-muted);
		display: flex;
		gap: 0.4rem;
		flex-wrap: wrap;
		align-items: baseline;
	}
	.sub > span + span::before {
		content: '·';
		margin-right: 0.4rem;
		opacity: 0.5;
	}
</style>
