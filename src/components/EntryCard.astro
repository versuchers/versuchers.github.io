---
import { href, KIND_LABEL, cardText, authorLine, type Entry } from '../lib/data';
import Poster from './Poster.astro';

interface Props {
	entry: Entry;
	/** Poster'in altındaki tür şeridi (Film/Dizi/Kitap) gösterilsin mi? */
	showType?: boolean;
	eager?: boolean;
	/** Alt bilgi düzeyi: 'compact' → film yalnız yıl, dizi/kitap yalnız ad. */
	subMode?: 'full' | 'compact';
	/** Kart altında gösterilecek rol etiketleri (kişi sayfası). */
	roles?: string[];
	/** Yazar satırını gizle (kişi sayfasında kişinin kendi adı gereksiz tekrar). */
	hideAuthor?: boolean;
}

const {
	entry,
	showType = false,
	eager = false,
	subMode = 'full',
	roles = [],
	hideAuthor = false,
} = Astro.props;

const displayTitle = entry.type === 'film' ? entry.fullTitle || entry.title : entry.title;

const authorText = authorLine(entry);
const ct = cardText(entry);
let sub = '';
if (entry.type === 'film') {
	sub = ct;
} else if (entry.type === 'dizi' && subMode === 'full') {
	sub = ct;
}
---

<a class="card entry-card" href={href(entry)}>
	<div class="poster-wrap">
		<Poster src={entry.poster} alt={displayTitle} kind={entry.type} eager={eager} />
	</div>
	{showType && <span class="type-strip">{KIND_LABEL[entry.type]}</span>}
	<div class="body">
		<h3 class="title" title={displayTitle}>{displayTitle}</h3>
		<p class="sub">
			{authorText && !hideAuthor && <span class="author">{authorText}</span>}
			{sub && <span class="year">{sub}</span>}
		</p>
		{roles.length > 0 && <p class="card-roles">{roles.join(' · ')}</p>}
	</div>
</a>


