---
/**
 * "Son dinlenenler" — Last.fm'den build zamanında çekilen son çalmalar.
 * Veri: scripts/fetch-lastfm.mjs → src/data/music/lastfm.json (env: LASTFM_API_KEY).
 * Veri yoksa bileşen hiçbir şey render etmez.
 * Gizlilik: yalnızca sanatçı / şarkı / albüm / tarih / kapak gösterilir.
 */
import MusicCover from './MusicCover.astro';
import { lastfm, tracks, hasTrack, cover, MONTHS_TR } from '../lib/music';
import { fold } from '../lib/text';

const rows = (lastfm.tracks || []).slice(0, 6);
if (rows.length === 0) return null;

// Aynı şarkı arşivde varsa yerel detay sayfasına bağla.
const localKey = (a: string, n: string) => `${fold(a)}|${fold(n)}`;
const local = new Map(tracks.map((t) => [localKey(t.artist, t.name), t.slug]));

const stamp = (uts: number): string => {
	const d = new Date(uts * 1000 + 3 * 3600 * 1000); // UTC+3
	const hh = String(d.getUTCHours()).padStart(2, '0');
	const mm = String(d.getUTCMinutes()).padStart(2, '0');
	return `${d.getUTCDate()} ${MONTHS_TR[d.getUTCMonth()]} ${d.getUTCFullYear()} · ${hh}:${mm}`;
};

const updated = (() => {
	if (!lastfm.fetchedAt) return '';
	const d = new Date(new Date(lastfm.fetchedAt).getTime() + 3 * 3600 * 1000);
	const hh = String(d.getUTCHours()).padStart(2, '0');
	const mm = String(d.getUTCMinutes()).padStart(2, '0');
	return `${d.getUTCDate()} ${MONTHS_TR[d.getUTCMonth()]} ${d.getUTCFullYear()}, ${hh}:${mm}`;
})();
---

<section class="panel">
	<div class="section-head">
		<h2>Son dinlenenler</h2>
		<span class="more muted">Last.fm{updated && ` · ${updated}’de güncellendi`}</span>
	</div>
	<ol class="lfm">
		{
			rows.map((r) => {
				const slug = local.get(localKey(r.artist, r.name));
				const href = hasTrack(slug) ? `/muzik/sarki/${slug}` : null;
				const playing = r.date === null;
				// Last.fm görseli yoksa (veya ölüyse) arşivdeki kapağa düş:
				// o da zaten log deposundan geliyor.
				const img = r.image ?? (slug && hasTrack(slug) ? cover('track', slug) : undefined);
				return (
					<li class="lr">
						<div class="cv">
							<MusicCover src={img} alt={r.name} />
						</div>
						<div class="txt">
							{href ? (
								<a href={href}>
									<span class="t">{r.name}</span>
								</a>
							) : (
								<span class="t">{r.name}</span>
							)}
							<span class="s muted">
								{r.artist}
								{r.album && ` · ${r.album}`}
							</span>
						</div>
						{playing ? (
							<span class="now">♪ çalıyor</span>
						) : (
							<span class="when">{r.date ? stamp(r.date) : ''}</span>
						)}
					</li>
				);
			})
		}
	</ol>
</section>

<style>
	.lfm {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--border);
	}
	.lr {
		display: grid;
		grid-template-columns: 40px 1fr auto;
		align-items: center;
		gap: 0.9rem;
		padding: 0.5rem 0.2rem;
		border-bottom: 1px solid var(--border);
	}
	.cv {
		width: 40px;
	}
	.cv :global(.mcover) {
		width: 40px;
	}
	.txt {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}
	.txt a {
		color: inherit;
	}
	.txt a:hover .t {
		color: var(--link-hover);
	}
	.t {
		font-family: var(--font-card);
		font-size: 1.05rem;
		line-height: 1.25;
		transition: color var(--dur) var(--ease);
	}
	.s {
		font-family: var(--font-meta);
		font-size: 0.84rem;
		line-height: 1.3;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.when {
		font-family: var(--font-meta);
		font-size: 0.78rem;
		color: var(--text-muted);
		white-space: nowrap;
	}
	.now {
		font-family: var(--font-ui);
		font-size: 0.66rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent);
		white-space: nowrap;
	}
	@media (max-width: 560px) {
		.when {
			display: none;
		}
	}
</style>
