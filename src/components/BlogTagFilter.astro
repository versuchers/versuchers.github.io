---
/**
 * Blog etiket süzgeci.
 *
 * Yazı listesinin hemen üstünde çip şeridi olarak durur. Çipe tıklanınca
 * liste sayfa yenilenmeden süzülür; seçim URL'ye (?etiket=...) yansır.
 *
 * Etiketler yazıların frontmatter'ındaki `tags` alanından build sırasında
 * toplanır. Şifreli yazılar sanal bir etiket ("kilitli") olarak listenin
 * sonunda, hafifçe ayrışmış biçimde durur.
 */
import { tagSlug } from '../lib/text';

interface Props {
	/** Süzülecek yazılar: { tags, encrypted } yeterli. */
	posts: { tags: string[]; encrypted: boolean }[];
}

const { posts } = Astro.props;

const LOCKED_ID = 'kilitli';
const LOCKED_LABEL = 'Kilitli';

/** Görünen etiket adı: önce yazıların içinde geçtiği hâliyle topla. */
const labelOf = new Map<string, string>();
const counts = new Map<string, number>();

for (const post of posts) {
	for (const tag of post.tags) {
		const key = tagSlug(tag);
		if (!key) continue;
		if (!labelOf.has(key)) labelOf.set(key, String(tag).trim());
		counts.set(key, (counts.get(key) ?? 0) + 1);
	}
}

// Aynı slug'a düşen adlar (ör. "kısa öykü" / "kısa-öykü") varsa daha sık
// geçen ad kazanır; sayımlar zaten tek anahtarda toplandı.
const lockedCount = posts.filter((p) => p.encrypted).length;

const items = [...counts.entries()]
	.map(([id, count]) => ({ id, label: labelOf.get(id) ?? id, count, locked: false }))
	.sort((a, b) => b.count - a.count || a.label.localeCompare(b.label, 'tr'));

if (lockedCount > 0) {
	items.push({ id: LOCKED_ID, label: LOCKED_LABEL, count: lockedCount, locked: true });
}

const total = posts.length;
---

<div class="tagfilter" data-tagfilter data-total={String(total)}>
	<div class="tf-chips" role="group" aria-label="Etikete göre süz">
		<button type="button" class="tf-chip is-active" data-tag="" aria-pressed="true">
			<span class="tf-name">Tümü</span>
			<span class="tf-count" aria-hidden="true">{total}</span>
		</button>
		{
			items.map((item) => (
				<button
					type="button"
					class:list={['tf-chip', item.locked && 'is-locked']}
					data-tag={item.id}
					data-label={item.label}
					data-locked={item.locked ? 'true' : undefined}
					aria-pressed="false"
				>
					{item.locked && (
						<svg
							class="tf-lock"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.6"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<rect x="5" y="10.5" width="14" height="9.5" rx="1.6" />
							<path d="M8.2 10.5V7.6a3.8 3.8 0 0 1 7.6 0v2.9" />
							<circle cx="12" cy="15" r="1.1" fill="currentColor" stroke="none" />
							<path d="M12 16.1v1.9" />
						</svg>
					)}
					<span class="tf-name">{item.label}</span>
					<span class="tf-count" aria-hidden="true">{item.count}</span>
				</button>
			))
		}
	</div>

	<p class="tf-status muted" data-tf-status aria-live="polite">{total} yazı</p>
	<p class="tf-empty muted" data-tf-empty hidden>Bu etikette yazı yok.</p>
</div>

<style>
	.tagfilter {
		margin-bottom: 1.25rem;
	}

	/* Çip şeridi: masaüstünde satır kaydırmalı flex, mobilde yatay kaydırma. */
	.tf-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.tf-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.35em;
		margin: 0;
		padding: 0.24em 0.7em;
		border: 1px solid var(--border);
		/* Yuvarlak kapsül değil, hafif yumuşatılmış köşe. */
		border-radius: var(--radius-sm);
		background: var(--surface-2);
		color: var(--text-muted);
		/* Kart altındaki etiketle aynı dil: Manufacturing Consent 18px. */
		font-family: var(--font-display);
		font-size: 18px;
		line-height: 1.5;
		text-transform: lowercase;
		white-space: nowrap;
		cursor: pointer;
		transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease),
			background-color var(--dur) var(--ease);
	}
	.tf-chip:hover {
		color: var(--link-hover);
		border-color: var(--link-hover);
		background: var(--accent-soft);
	}
	.tf-chip:focus-visible {
		outline: var(--ring) solid var(--link-hover);
		outline-offset: 2px;
	}
	.tf-chip.is-active {
		color: var(--text);
		border-color: var(--accent);
		background: var(--accent-soft);
	}
	/* Aktif çip hover'da görünümünü korur, yalnızca kenarlık vurgulanır. */
	.tf-chip.is-active:hover {
		color: var(--text);
		border-color: var(--link-hover);
		background: var(--accent-soft);
	}

	.tf-count {
		color: var(--text-faint);
		font-size: 0.9em;
	}
	.tf-chip.is-active .tf-count {
		color: var(--text-muted);
	}

	.tf-lock {
		width: 0.85em;
		height: 0.85em;
		flex: none;
		opacity: 0.75;
	}
	/* Kilitli çip: gerçek etiketlerden hafifçe ayrışsın. */
	.tf-chip.is-locked {
		margin-left: 0.65rem;
		border-style: dashed;
	}

	.tf-status {
		margin: 0.6rem 0 0;
		font-family: var(--font-ui);
		font-size: 0.8rem;
	}
	.tf-empty {
		margin: 0.35rem 0 0;
		font-family: var(--font-ui);
		font-size: 0.85rem;
	}

	/* JS yoksa: çipler pasif görünür, liste olduğu gibi kalır. */
	.tagfilter:not([data-ready]) .tf-chip {
		cursor: default;
		pointer-events: none;
		opacity: 0.7;
	}
	.tagfilter:not([data-ready]) .tf-chip.is-active {
		opacity: 1;
	}

	@media (max-width: 768px) {
		/* Mobilde tek satırda yatay kaydırılabilir şerit. */
		.tf-chips {
			flex-wrap: nowrap;
			overflow-x: auto;
			scroll-snap-type: x proximity;
			scrollbar-width: none;
			-ms-overflow-style: none;
			padding-bottom: 2px;
		}
		.tf-chips::-webkit-scrollbar {
			display: none;
		}
		.tf-chip {
			scroll-snap-align: start;
			flex: none;
		}
	}
</style>

<script>
	import { tagSlug } from '../lib/text';

	const LOCKED_ID = 'kilitli';
	const PARAM = 'etiket';

	/** Yazıların bağlı olduğu etiket anahtarlarını karttan okur. */
	function tagsOf(cell: HTMLElement): string[] {
		return (cell.dataset.tags ?? '').split(' ').filter(Boolean);
	}

	for (const root of document.querySelectorAll<HTMLElement>('[data-tagfilter]')) {
		const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('.tf-chip'));
		const status = root.querySelector<HTMLElement>('[data-tf-status]');
		const empty = root.querySelector<HTMLElement>('[data-tf-empty]');
		if (chips.length === 0) continue;

		// Süzülecek kartlar: bu bileşenin hemen ardındaki listenin hücreleri.
		const list = root.parentElement?.querySelector<HTMLElement>('.posts');
		if (!list) continue;
		const cells = Array.from(list.children) as HTMLElement[];
		const total = cells.length;

		const slugs = new Set(chips.map((c) => c.dataset.tag ?? ''));
		const lockedChip = chips.find((c) => c.dataset.locked === 'true');
		const totalText = `${total} yazı`;

		function select(raw: string | null) {
			let id = (raw ?? '').trim();
			if (id && !slugs.has(id)) {
				// Bilinmeyen/tutarsız değer: etiket adı olarak yorumla.
				const guess = tagSlug(id);
				id = slugs.has(guess) ? guess : '';
			}
			return id;
		}

		function apply(id: string, updateUrl = true) {
			let visible = 0;
			for (const cell of cells) {
				const tags = tagsOf(cell);
				const on =
					id === ''
						? true
						: id === LOCKED_ID
							? cell.dataset.locked === 'true'
							: tags.includes(id);
				cell.hidden = !on;
				if (on) visible++;
			}

			for (const chip of chips) {
				const active = (chip.dataset.tag ?? '') === id;
				chip.classList.toggle('is-active', active);
				chip.setAttribute('aria-pressed', active ? 'true' : 'false');
			}

			const label = id === '' ? '' : (chips.find((c) => c.dataset.tag === id)?.dataset.label ?? id);
			if (status) status.textContent = id === '' ? totalText : `${visible} yazı · ${label}`;
			if (empty) empty.hidden = visible > 0;

			if (updateUrl) {
				const url = new URL(window.location.href);
				if (id === '') url.searchParams.delete(PARAM);
				else url.searchParams.set(PARAM, id);
				history.replaceState(null, '', url);
			}
		}

		for (const chip of chips) {
			chip.addEventListener('click', () => {
				const id = chip.dataset.tag ?? '';
				// Aktif çipe tekrar tıklamak ya da "Tümü" → süzgeci kaldır.
				const next = chip.classList.contains('is-active') && id !== '' ? '' : id;
				apply(next);
			});
		}

		// Kilitli sayısı değişirse (veri güncellenince) kapalıysa çipi gizle.
		if (lockedChip) {
			const lockedCount = cells.filter((c) => c.dataset.locked === 'true').length;
			if (lockedCount === 0) lockedChip.hidden = true;
		}

		root.dataset.ready = '';
		apply(select(new URLSearchParams(window.location.search).get(PARAM)), false);
	}
</script>
