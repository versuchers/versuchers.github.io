---
import type { CollectionEntry } from 'astro:content';
import { formatTrDate } from '../lib/format';
import { tagSlug } from '../lib/text';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, pubDate, tags } = post.data;
---

<li>
	<article class="post">
		<h2><a class="post-link" href={`/blog/${post.id}`}>{title}</a></h2>
		<time datetime={pubDate.toISOString()}>
			{formatTrDate(pubDate.toLocaleDateString('tr-TR'))}
		</time>
		{
			tags.length > 0 && (
				<div class="chip-list">
					{tags.map((t) => (
						<a class="chip" href={`/blog/etiket/${tagSlug(t)}`}>
							{t}
						</a>
					))}
				</div>
			)
		}
	</article>
</li>
