---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/format';
import { tagSlug, titleCaseTr } from '../lib/text';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, pubDate, tags, encrypted } = post.data;

// Etiket süzgeci (BlogTagFilter) bu attribute'ları okur; kart sırası ve
// görünümü değişmez, yalnızca süzme bilgisi DOM'a yazılır.
const tagKeys = tags.map((t) => tagSlug(t)).filter(Boolean);
---

<li data-tags={tagKeys.join(' ')} data-locked={encrypted ? 'true' : undefined}>
	<article class="post">
		{
			encrypted && (
				<span class="lock" role="img" aria-label="Şifreli yazı" title="Şifreli yazı">
					<svg
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.6"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<rect x="5" y="10.5" width="14" height="9.5" rx="1.6" />
						<path d="M8.2 10.5V7.6a3.8 3.8 0 0 1 7.6 0v2.9" />
						<circle cx="12" cy="15" r="1.1" fill="currentColor" stroke="none" />
						<path d="M12 16.1v1.9" />
					</svg>
				</span>
			)
		}
		<h2><a class="post-link" href={`/blog/${post.id}`}>{titleCaseTr(title)}</a></h2>
		<time datetime={pubDate.toISOString()}>
			{formatDate(pubDate)}
		</time>
		{
			tags.length > 0 && (
				<div class="chip-list">
					{tags.map((t, i) => (
						<>
							{i > 0 && <span class="chip-sep" aria-hidden="true">{'//'}</span>}
							<a class="chip" href={`/blog/etiket/${tagSlug(t)}`}>
								{t}
							</a>
						</>
					))}
				</div>
			)
		}
	</article>
</li>

<style>
	.post .lock {
		position: absolute;
		top: 12px;
		right: 14px;
		z-index: 4;
		display: grid;
		place-items: center;
		width: 24px;
		height: 24px;
		color: var(--accent-2);
		opacity: 0.8;
		pointer-events: none;
		transition: opacity 0.15s ease;
	}
	.post:hover .lock {
		opacity: 1;
	}
	.post .lock svg {
		display: block;
		width: 100%;
		height: 100%;
	}
</style>
