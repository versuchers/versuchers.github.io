---
import { KIND_PLURAL, type Kind, type Entry } from '../lib/data';
import { parseTrDate } from '../lib/format';
import { fold } from '../lib/text';
import EntryCard from './EntryCard.astro';

interface Props {
	kind: Kind;
	items: Entry[];
	/** Açılış sıralaması; varsayılan başlığa göre (A→Z). */
	defaultSort?: 'title' | 'rating' | 'year' | 'review' | 'added';
}

const { kind, items, defaultSort = 'title' } = Astro.props;

function primaryGenre(e: Entry): string {
	if (e.type === 'film') return e.genre;
	if (e.type === 'dizi') return e.genre;
	return e.category;
}

/** Yapım/basım yılı: film ve dizide üretim yılı, kitapta orijinal basım yılı. */
function productionYear(e: Entry): string {
	return e.type === 'kitap' ? e.originalYear || '' : e.year || '';
}
/** İzleme/okuma yılı: türetilmiş sayısal alan (ayrıştırılamadıysa null). */
function watchedYear(e: Entry): number | null {
	return e.type === 'kitap' ? e.okunmaYili : e.izlenmeYili;
}

// Etiketler (tür bazında)
const productionYearLabel = kind === 'kitap' ? 'Basım yılı' : 'Yapım yılı';
const watchedYearLabel = kind === 'kitap' ? 'Okunduğu yıl' : 'İzlendiği yıl';

// Facet değerleri
const genres = new Set<string>();
const years = new Set<string>();
const watchedYears = new Set<number>();
for (const e of items) {
	(primaryGenre(e) || '')
		.split(',')
		.forEach((g) => g.trim() && genres.add(g.trim()));
	const py = productionYear(e);
	if (py) years.add(py);
	const wy = watchedYear(e);
	if (wy !== null) watchedYears.add(wy); // null yıllar seçenekte görünmez
}
const genreList = [...genres].sort((a, b) => a.localeCompare(b, 'tr'));
const yearList = [...years].sort((a, b) => Number(b) - Number(a));
const watchedYearList = [...watchedYears].sort((a, b) => b - a);

// Başlangıç sıralaması
const sortOptions = [
	{ id: 'title', label: 'Başlığa göre (A→Z)' },
	{ id: 'rating', label: 'Puana göre (yüksek→düşük)' },
	{ id: 'year', label: 'Yıla göre (yeni→eski)' },
	{ id: 'review', label: 'Son yorumlanan' },
	{ id: 'added', label: 'Ekleme sırası' },
];

// Sunucu da açılış sıralamasını uygular: ilk boyama zaten bu sırada olur,
// istemci tarafındaki yeniden sıralama geldiğinde kartlar yerinde durur
// (alfabetik → puan sıçraması yaşanmaz). Karşılaştırıcılar aşağıdaki
// istemci script'indeki switch ile birebir aynıdır; JS sort kararlı olduğu
// için eşit öğeler de her iki tarafta aynı sırada kalır.
const collator = new Intl.Collator('tr');
const sorters: Record<string, (a: Entry, b: Entry) => number> = {
	title: (a, b) => collator.compare(fold(a.title), fold(b.title)),
	rating: (a, b) => (b.rating ?? 0) - (a.rating ?? 0),
	year: (a, b) => Number(productionYear(b) || 0) - Number(productionYear(a) || 0),
	review: (a, b) =>
		(parseTrDate(b.reviewDate)?.getTime() ?? 0) -
		(parseTrDate(a.reviewDate)?.getTime() ?? 0),
	added: () => 0,
};
// Orijinal indeks korunur: data-index her zaman kaynak dizideki konumdur
// ("Ekleme sırası" seçeneği ve arama indeksi buna göre çalışır).
const sortedItems = items
	.map((e, index) => ({ e, index }))
	.sort((a, b) => (sorters[defaultSort] ?? sorters.title)(a.e, b.e));
---

<div class="browse" data-browse data-kind={kind}>
	<div class="controls">
		<label class="search">
			<span class="visually-hidden">Ara</span>
			<span class="icon" aria-hidden="true">⌕</span>
			<input
				type="search"
				data-f="search"
				placeholder={`${KIND_PLURAL[kind]} içinde ara…`}
				autocomplete="off"
			/>
		</label>

		<label class="field">
			<span>Tür</span>
			<select data-f="genre">
				<option value="">Hepsi</option>
				{genreList.map((g) => <option value={fold(g)}>{g}</option>)}
			</select>
		</label>

		<label class="field">
			<span>{productionYearLabel}</span>
			<select data-f="year">
				<option value="">Hepsi</option>
				{yearList.map((y) => <option value={y}>{y}</option>)}
			</select>
		</label>

		<label class="field">
			<span>{watchedYearLabel}</span>
			<select data-f="wyear">
				<option value="">Hepsi</option>
				{watchedYearList.map((y) => <option value={y}>{y}</option>)}
			</select>
		</label>

		<label class="field">
			<span>Puan</span>
			<select data-f="rating">
				<option value="">Hepsi</option>
				<option value="9">9+</option>
				<option value="8">8+</option>
				<option value="7">7+</option>
				<option value="6">6+</option>
				<option value="5">5+</option>
			</select>
		</label>

		<label class="field">
			<span>Sırala</span>
			<select data-f="sort">
				{sortOptions.map((s) => (
					<option value={s.id} selected={s.id === defaultSort}>{s.label}</option>
				))}
			</select>
		</label>

		<button type="button" class="btn reset" data-f="reset">Sıfırla</button>
	</div>

	<div class="status">
		<span data-count class="muted">{items.length} kayıt</span>
	</div>

	<h2 class="visually-hidden">{KIND_PLURAL[kind]} listesi</h2>

	<ul class="grid browse-grid">
		{
			sortedItems.map(({ e, index }) => (
				<li
					class="cell"
					data-title={fold(e.title)}
					data-genre={fold(primaryGenre(e) || '')}
					data-year={productionYear(e)}
					data-wyear={watchedYear(e) ?? ''}
					data-rating={String(e.rating ?? 0)}
					data-review={String(parseTrDate(e.reviewDate)?.getTime() ?? 0)}
					data-index={String(index)}
				>
					<EntryCard entry={e} />
				</li>
			))
		}
	</ul>

	<p class="empty muted" data-empty hidden>Aramanla eşleşen kayıt yok. Filtreleri sıfırlamayı dene.</p>
</div>

<script>
	import { fold } from '../lib/text';

	type SortId = 'title' | 'rating' | 'year' | 'review' | 'added';

	document.querySelectorAll<HTMLElement>('[data-browse]').forEach((root) => {
		const grid = root.querySelector<HTMLElement>('.browse-grid');
		if (!grid) return;
		const kind = root.dataset.kind ?? '';
		const cells = Array.from(grid.children) as HTMLElement[];
		const search = root.querySelector<HTMLInputElement>('[data-f="search"]')!;
		const genre = root.querySelector<HTMLSelectElement>('[data-f="genre"]')!;
		const year = root.querySelector<HTMLSelectElement>('[data-f="year"]')!;
		const wyear = root.querySelector<HTMLSelectElement>('[data-f="wyear"]')!;
		const rating = root.querySelector<HTMLSelectElement>('[data-f="rating"]')!;
		const sort = root.querySelector<HTMLSelectElement>('[data-f="sort"]')!;
		const reset = root.querySelector<HTMLButtonElement>('[data-f="reset"]')!;
		const count = root.querySelector<HTMLElement>('[data-count]')!;
		const empty = root.querySelector<HTMLElement>('[data-empty]')!;

		// Başlangıç sıralaması: sunucunun işaretlediği varsayılan seçenekten okunur
		// (frontmatter değişkeni istemci bloğuna taşınmaz).
		const defaultSort =
			sort.querySelector<HTMLOptionElement>('option[selected]')?.value ?? 'title';

		const num = (el: HTMLElement, key: string) => Number(el.dataset[key] ?? 0);

		// Arama metni DOM'da tutulmaz; sayfa boyutunu küçük tutmak için yalnız
		// gerektiğinde (ilk aramada) ayrı bir indeks dosyasından indirilir.
		let index: string[] | null = null;
		let indexLoading = false;
		let indexError = false;
		async function ensureIndex() {
			if (index || indexLoading || indexError) return;
			indexLoading = true;
			try {
				const url = `/search-index/${kind}.json`;
				let data: string[] = await (await fetch(url)).json();
				// Sayfa ile indeks sürümü uyuşmuyorsa (ör. CDN önbelleği) tazele.
				if (data.length !== cells.length) {
					data = await (await fetch(`${url}?t=${Date.now()}`)).json();
				}
				index = data;
			} catch {
				indexError = true;
			} finally {
				indexLoading = false;
			}
		}

		function apply() {
			const q = fold(search.value.trim());
			const g = genre.value;
			const y = year.value;
			const wy = wyear.value;
			const r = rating.value ? Number(rating.value) : 0;

			if (q && !index) {
				if (!indexError) ensureIndex().then(apply);
				count.textContent = indexError ? 'Arama indeksi yüklenemedi' : 'Aranıyor…';
				return;
			}

			let visible = 0;
			for (const cell of cells) {
				let ok = true;
				if (q && !(index?.[num(cell, 'index')] ?? '').includes(q)) ok = false;
				if (ok && g && !(cell.dataset.genre ?? '').includes(g)) ok = false;
				if (ok && y && cell.dataset.year !== y) ok = false;
				// İzleme/okuma yılı: null yıllar ("Hepsi" açıkken görünür) seçili
				// yılda eşleşmediği için listeden çıkar.
				if (ok && wy && (cell.dataset.wyear ?? '') !== wy) ok = false;
				if (ok && r && num(cell, 'rating') < r) ok = false;

				cell.hidden = !ok;
				if (ok) visible++;
			}

			// Sıralama
			const mode = sort.value as SortId;
			const sorted = [...cells].sort((a, b) => {
				switch (mode) {
					case 'rating':
						return num(b, 'rating') - num(a, 'rating');
					case 'year':
						return num(b, 'year') - num(a, 'year');
					case 'review':
						return num(b, 'review') - num(a, 'review');
					case 'added':
						return num(a, 'index') - num(b, 'index');
					default:
						return (a.dataset.title ?? '').localeCompare(b.dataset.title ?? '', 'tr');
				}
			});
			for (const cell of sorted) grid!.appendChild(cell);

			count.textContent = `${visible} kayıt`;
			empty.hidden = visible !== 0;
		}

		[search, genre, year, wyear, rating, sort].forEach((el) =>
			el.addEventListener('input', apply),
		);
		search.addEventListener('focus', ensureIndex, { once: true });
		reset.addEventListener('click', () => {
			search.value = '';
			genre.value = '';
			year.value = '';
			wyear.value = '';
			rating.value = '';
			sort.value = defaultSort;
			apply();
		});

		// URL parametrelerinden başlangıç durumu (?q= &tur= &yil= &izyil=)
		const params = new URLSearchParams(location.search);
		if (params.get('q')) search.value = params.get('q')!;
		if (params.get('tur')) genre.value = fold(params.get('tur')!);
		if (params.get('yil')) year.value = params.get('yil')!;
		if (params.get('izyil')) wyear.value = params.get('izyil')!;

		apply();
	});
</script>

<style>
	.controls {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		align-items: flex-end;
		padding: 1rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
		margin-bottom: 1rem;
	}

	.search {
		flex: 1 1 260px;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-sm);
		background: var(--bg-2);
		padding: 0 0.75rem;
		height: 2.6rem;
	}
	.search:focus-within {
		border-color: var(--accent);
	}
	.search .icon {
		color: var(--text-muted);
		font-size: 1.1rem;
	}
	.search input {
		border: 0;
		background: transparent;
		color: var(--text);
		width: 100%;
		height: 100%;
		font-family: var(--font-ui);
		font-size: 0.95rem;
		outline: none;
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		font-family: var(--font-ui);
		font-size: 0.72rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--text-muted);
	}
	.field > span {
		padding-left: 0.15rem;
	}

	select {
		height: 2.6rem;
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-sm);
		background: var(--bg-2);
		color: var(--text);
		font-family: var(--font-ui);
		font-size: 0.82rem;
		padding: 0 0.6rem;
		min-width: 9rem;
	}
	select:focus {
		outline: none;
		border-color: var(--accent);
	}

	.reset {
		height: 2.6rem;
	}

	.status {
		margin-bottom: 0.75rem;
		font-size: 0.88rem;
	}

	/* Liste kendi kutusunda durur: denetim çubuğuyla aynı zemin/çerçeve,
	   böylece grid arka plandan ayrışır. */
	.browse-grid {
		padding: 1rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
	}

	/* Kutu iç boşluğu kartlara yer bırakmadığında iki sütuna zorlanır:
	   dar mobilde ve kutu dolgusunun sınırda kaldığı 421–640px aralığında. */
	@media (max-width: 640px) {
		.browse-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0.6rem;
			padding: 0.6rem;
		}
	}

	.cell[hidden] {
		display: none;
	}

	.empty {
		padding: 2rem 0;
	}
</style>
