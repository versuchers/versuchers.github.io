---
import { searchText, fold, KIND_LABEL, type Entry } from '../lib/data';
import { parseTrDate } from '../lib/format';
import EntryCard from './EntryCard.astro';

interface Props {
	items: Entry[];
}

const { items } = Astro.props;

const typeOptions = [
	{ id: '', label: 'Tümü' },
	{ id: 'film', label: 'Film' },
	{ id: 'dizi', label: 'Dizi' },
	{ id: 'kitap', label: 'Kitap' },
];

const sortOptions = [
	{ id: 'relevant', label: 'İlgiye göre' },
	{ id: 'title', label: 'Başlığa göre (A→Z)' },
	{ id: 'rating', label: 'Puana göre (yüksek→düşük)' },
	{ id: 'year', label: 'Yıla göre (yeni→eski)' },
	{ id: 'review', label: 'Son yorumlanan' },
];
---

<div class="browse" data-search-root>
	<div class="controls">
		<label class="search">
			<span class="visually-hidden">Ara</span>
			<span class="icon" aria-hidden="true">⌕</span>
			<input
				type="search"
				data-f="search"
				placeholder="Film, dizi, kitap, kişi, tür, tema… ara"
				autocomplete="off"
			/>
		</label>

		<label class="field">
			<span>Tür</span>
			<select data-f="type">
				{typeOptions.map((t) => <option value={t.id}>{t.label}</option>)}
			</select>
		</label>

		<label class="field">
			<span>Sırala</span>
			<select data-f="sort">
				{sortOptions.map((s) => <option value={s.id}>{s.label}</option>)}
			</select>
		</label>

		<button type="button" class="btn reset" data-f="reset">Sıfırla</button>
	</div>

	<div class="chips" data-chips hidden aria-label="Etkin süzgeçler"></div>

	<div class="status">
		<span data-count class="muted">{items.length} kayıt</span>
	</div>

	<ul class="grid browse-grid">
		{
			items.map((e, index) => (
				<li
					class="cell"
					data-search={searchText(e)}
					data-type={e.type}
					data-title={fold(e.type === 'film' ? e.fullTitle || e.title : e.title)}
					data-rating={String(e.rating ?? 0)}
					data-year={e.year || ''}
					data-review={String(parseTrDate(e.reviewDate)?.getTime() ?? 0)}
					data-index={String(index)}
				>
					<EntryCard entry={e} showType />
				</li>
			))
		}
	</ul>

	<p class="empty muted" data-empty hidden>Aramayla eşleşen kayıt yok.</p>
</div>

<script>
	function fold(s: string): string {
		const map: Record<string, string> = {
			ç: 'c', ğ: 'g', ı: 'i', ö: 'o', ş: 's', ü: 'u', â: 'a', î: 'i', û: 'u',
		};
		return s.toLowerCase().replace(/[çğıöşüâîû]/g, (c) => map[c] ?? c);
	}

	document.querySelectorAll<HTMLElement>('[data-search-root]').forEach((root) => {
		const grid = root.querySelector<HTMLElement>('.browse-grid');
		if (!grid) return;
		const cells = Array.from(grid.children) as HTMLElement[];
		const search = root.querySelector<HTMLInputElement>('[data-f="search"]')!;
		const type = root.querySelector<HTMLSelectElement>('[data-f="type"]')!;
		const sort = root.querySelector<HTMLSelectElement>('[data-f="sort"]')!;
		const reset = root.querySelector<HTMLButtonElement>('[data-f="reset"]')!;
		const count = root.querySelector<HTMLElement>('[data-count]')!;
		const empty = root.querySelector<HTMLElement>('[data-empty]')!;
		const chips = root.querySelector<HTMLElement>('[data-chips]');

		// Detay sayfalarından gelen terimler arama kutusunu doldurmaz; sonuçların
		// üstünde kaldırılabilir birer etiket (süzgeç) olarak gösterilir.
		const tags: string[] = [];

		function renderChips() {
			if (!chips) return;
			chips.replaceChildren();
			chips.hidden = tags.length === 0;
			tags.forEach((tag, i) => {
				const chip = document.createElement('span');
				chip.className = 'fchip';
				const label = document.createElement('span');
				label.textContent = tag;
				const btn = document.createElement('button');
				btn.type = 'button';
				btn.textContent = '×';
				btn.setAttribute('aria-label', `${tag} etiketini kaldır`);
				btn.addEventListener('click', () => {
					tags.splice(i, 1);
					renderChips();
					apply();
				});
				chip.append(label, btn);
				chips.appendChild(chip);
			});
		}

		const num = (el: HTMLElement, key: string) => Number(el.dataset[key] ?? 0);

		function apply() {
			const tokens = fold(search.value.trim()).split(/\s+/).filter(Boolean);
			const tagTokens = tags.map((tag) => fold(tag));
			const t = type.value;

			let visible = 0;
			for (const cell of cells) {
				const text = cell.dataset.search ?? '';
				const matches =
					tokens.every((tok) => text.includes(tok)) && tagTokens.every((tok) => text.includes(tok));
				const ok = matches && (!t || cell.dataset.type === t);
				cell.hidden = !ok;
				if (ok) visible++;
			}

			const mode = sort.value;
			const sorted = [...cells].sort((a, b) => {
				switch (mode) {
					case 'rating':
						return num(b, 'rating') - num(a, 'rating');
					case 'year':
						return num(b, 'year') - num(a, 'year');
					case 'review':
						return num(b, 'review') - num(a, 'review');
					case 'title':
						return (a.dataset.title ?? '').localeCompare(b.dataset.title ?? '', 'tr');
					default: {
						if (!tokens.length) return num(a, 'index') - num(b, 'index');
						const pa = fold(a.dataset.title ?? '').startsWith(tokens[0]) ? 0 : 1;
						const pb = fold(b.dataset.title ?? '').startsWith(tokens[0]) ? 0 : 1;
						return pa - pb || num(a, 'index') - num(b, 'index');
					}
				}
			});
			for (const cell of sorted) grid!.appendChild(cell);

			count.textContent = `${visible} kayıt`;
			empty.hidden = visible !== 0;
		}

		[search, type, sort].forEach((el) => el.addEventListener('input', apply));
		reset.addEventListener('click', () => {
			search.value = '';
			type.value = '';
			sort.value = 'relevant';
			tags.length = 0;
			renderChips();
			apply();
		});

		const params = new URLSearchParams(location.search);
		const q = params.get('q');
		if (q) {
			tags.push(q);
			renderChips();
		}
		if (params.get('tur')) {
			const tur = params.get('tur')!;
			if (['film', 'dizi', 'kitap'].includes(tur)) type.value = tur;
		}
		apply();
	});
</script>

<style>
	.controls {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		align-items: flex-end;
		padding: 1rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
		margin-bottom: 1rem;
	}

	.chips {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 0.85rem;
	}
	.fchip {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.2rem 0.4rem 0.2rem 0.75rem;
		border: 1px solid var(--border-strong);
		border-radius: 999px;
		background: var(--accent-soft);
		color: var(--text);
		font-family: var(--font-ui);
		font-size: 0.84rem;
	}
	.fchip button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.2rem;
		height: 1.2rem;
		border: 0;
		border-radius: 50%;
		background: transparent;
		color: var(--text-muted);
		font-size: 1rem;
		line-height: 1;
		cursor: pointer;
	}
	.fchip button:hover {
		background: var(--border-strong);
		color: var(--text);
	}

	.search {
		flex: 1 1 260px;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-sm);
		background: var(--bg-2);
		padding: 0 0.75rem;
		height: 2.6rem;
	}
	.search:focus-within {
		border-color: var(--accent);
	}
	.search .icon {
		color: var(--text-muted);
		font-size: 1.1rem;
	}
	.search input {
		border: 0;
		background: transparent;
		color: var(--text);
		width: 100%;
		height: 100%;
		font-family: var(--font-ui);
		font-size: 0.95rem;
		outline: none;
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		font-family: var(--font-ui);
		font-size: 0.72rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--text-muted);
	}
	.field > span {
		padding-left: 0.15rem;
	}

	select {
		height: 2.6rem;
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-sm);
		background: var(--bg-2);
		color: var(--text);
		font-family: var(--font-ui);
		font-size: 0.82rem;
		padding: 0 0.6rem;
		min-width: 9rem;
	}
	select:focus {
		outline: none;
		border-color: var(--accent);
	}

	.reset {
		height: 2.6rem;
	}

	.status {
		margin-bottom: 0.75rem;
		font-size: 0.88rem;
	}

	.cell[hidden] {
		display: none;
	}

	.empty {
		padding: 2rem 0;
	}
</style>
