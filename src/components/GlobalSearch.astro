---
interface Props {
	total: number;
}

const { total } = Astro.props;
const typeOptions = [
	{ id: '', label: 'Tümü' },
	{ id: 'film', label: 'Film' },
	{ id: 'dizi', label: 'Dizi' },
	{ id: 'kitap', label: 'Kitap' },
	{ id: 'sanatci', label: 'Sanatçı' },
	{ id: 'playlist', label: 'Playlist' },
	{ id: 'muzik-tur', label: 'Müzik türü' },
];

const sortOptions = [
	{ id: 'relevant', label: 'İlgiye göre' },
	{ id: 'title', label: 'Başlığa göre (A→Z)' },
	{ id: 'rating', label: 'Puana göre (yüksek→düşük)' },
	{ id: 'year', label: 'Yıla göre (yeni→eski)' },
	{ id: 'review', label: 'Son yorumlanan' },
];

---

<div class="browse" data-search-root>
	<div class="controls">
		<label class="search">
			<span class="visually-hidden">Ara</span>
			<span class="icon" aria-hidden="true">⌕</span>
			<input
				type="search"
				data-f="search"
				placeholder="Film, dizi, kitap, kişi, tür, sanatçı, playlist… ara"
				autocomplete="off"
			/>
		</label>

		<label class="field">
			<span>Tür</span>
			<select data-f="type">
				{typeOptions.map((t) => <option value={t.id}>{t.label}</option>)}
			</select>
		</label>

		<label class="field">
			<span>Sırala</span>
			<select data-f="sort">
				{sortOptions.map((s) => <option value={s.id}>{s.label}</option>)}
			</select>
		</label>

		<button type="button" class="btn reset" data-f="reset">Sıfırla</button>
	</div>

	<div class="chips" data-chips hidden aria-label="Etkin süzgeçler"></div>

	<div class="status">
		<span data-count class="muted">{total} kayıt</span>
	</div>

			<h2 class="visually-hidden">Sonuçlar</h2>

		<template data-card-template>
			<li class="cell" data-type="" data-title="" data-rating="" data-year="" data-review="" data-index="">
				<a class="card entry-card" href="">
					<div class="poster-wrap">
						<figure class="frame poster">
							<img class="poster-img" src="" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
						</figure>
					</div>
					<span class="type-strip"></span>
					<div class="body">
						<h3 class="title"><span class="title-text"></span><span class="rank" hidden></span></h3>
						<p class="sub">
							<span class="author"></span>
							<span class="year"></span>
						</p>
						<p class="artist-match" hidden></p>
						<p class="card-roles" hidden></p>
					</div>
				</a>
			</li>
		</template>

		<ul class="grid browse-grid" aria-live="polite" aria-label="Arama sonuçları"></ul>

	<p class="empty muted" data-empty hidden>Aramayla eşleşen kayıt yok.</p>
</div>

	<script>
		import { fold, tagSlug } from '../lib/text';

		interface Item {
			u: string;
			t: string;
			ty: 'film' | 'dizi' | 'kitap' | 'sanatci' | 'playlist' | 'muzik-tur';
			p: string;
			a: string;
			s: string;
			r: number;
			y: string;
			rt: number;
			ft: string;
			q: string;
			idx: number;
			/** Tüm zamanlar sırası (yalnız sanatçı; "#N" rozeti). */
			rk?: number;
			/** Yuvarlak kapak (sanatçı). */
			rd?: boolean;
			/** Kare kapak (sanatçı, playlist): 2:3 poster çerçevesi kırpmasın. */
			sq?: boolean;
			/** Şarkı sayısı (playlist): ilgi sıralamasında çoktan aza. */
			tc?: number;
			/** Playlistteki sanatçı başına şarkı sayısı: [sözlük indeksi, adet]. */
			ac?: [number, number][];
		}

		/** Arama indeksi yanıtı: kayıtlar + playlist sanatçı sözlüğü. */
		interface SearchIndex {
			/** Görünen sanatçı adları (sözlük). */
			ad: string[];
			/** Katlanmış sanatçı adları (sözlük, `ad` ile aynı sırada). */
			af: string[];
			items: Item[];
		}

		/** Kişi → rol indeksi (yalnız aranan kişi için kart altı etiket üretir). */
		interface RolesFile {
			labels: Record<string, string>;
			people: Record<string, [number, string][]>;
		}

		const TYPE_STRIP: Record<string, string> = {
			film: 'Film',
			dizi: 'Dizi',
			kitap: 'Kitap',
			sanatci: 'Sanatçı',
			playlist: 'Playlist',
			'muzik-tur': 'Müzik türü',
		};

		/* 2:3 poster kullanan türler. Sonuç kümesinde bunlardan hiç yoksa
		   kartların poster yüksekliğini koruması gerekmez. */
		const POSTER_TYPES = new Set(['film', 'dizi', 'kitap']);

		document.querySelectorAll<HTMLElement>('[data-search-root]').forEach((root) => {
			const grid = root.querySelector<HTMLElement>('.browse-grid');
			const tpl = root.querySelector<HTMLTemplateElement>('[data-card-template]')!;
			if (!grid || !tpl) return;
			const search = root.querySelector<HTMLInputElement>('[data-f="search"]')!;
			const type = root.querySelector<HTMLSelectElement>('[data-f="type"]')!;
			const sort = root.querySelector<HTMLSelectElement>('[data-f="sort"]')!;
			const reset = root.querySelector<HTMLButtonElement>('[data-f="reset"]')!;
			const count = root.querySelector<HTMLElement>('[data-count]')!;
			const status = root.querySelector<HTMLElement>('.status');
			const empty = root.querySelector<HTMLElement>('[data-empty]')!;
			const chips = root.querySelector<HTMLElement>('[data-chips]');

			const tags: string[] = [];
			let items: Item[] = [];
			/** Playlist sanatçı sözlüğü (görünen ve katlanmış adlar). */
			let ad: string[] = [];
			let af: string[] = [];
			let roles: RolesFile | null = null;
			let loaded = false;
			let loading = false;
			let err = false;

			function renderChips() {
				if (!chips) return;
				chips.replaceChildren();
				chips.hidden = tags.length === 0;
				tags.forEach((tag, i) => {
					const chip = document.createElement('span');
					chip.className = 'fchip';
					const label = document.createElement('span');
					label.textContent = tag;
					const btn = document.createElement('button');
					btn.type = 'button';
					btn.textContent = '×';
					btn.setAttribute('aria-label', `${tag} etiketini kaldır`);
					btn.addEventListener('click', () => {
						tags.splice(i, 1);
						renderChips();
						apply();
					});
					chip.append(label, btn);
					chips.appendChild(chip);
				});
			}

			async function load() {
				if (loaded || loading || err) return;
				loading = true;
				try {
					const url = '/search-index/ara-kartlar.json';
					const data = (await (await fetch(url)).json()) as SearchIndex;
					items = data.items;
					ad = data.ad;
					af = data.af;
					loaded = true;
				} catch {
					err = true;
				} finally {
					loading = false;
				}
				// Kişi-rol indeksi yardımcı veri: alınamazsa arama yine çalışır.
				try {
					roles = (await (await fetch('/search-index/kisi-roller.json')).json()) as RolesFile;
				} catch {
					roles = null;
				}
			}

			/** Aranan metin bir kişiye tam denk geliyorsa o kişinin rollerini toplar. */
			function personRoles(): Map<number, string[]> {
				const map = new Map<number, string[]>();
				const r = roles;
				if (!r) return map;
				const candidates = [search.value.trim(), ...tags];
				const seen = new Set<string>();
				for (const cand of candidates) {
					if (!cand) continue;
					const slug = tagSlug(cand);
					if (!slug || seen.has(slug)) continue;
					const credits = r.people[slug];
					if (!credits) continue;
					seen.add(slug);
					for (const [idx, mask] of credits) {
						let labels = map.get(idx);
						if (!labels) {
							labels = [];
							map.set(idx, labels);
						}
						for (const ch of mask) {
							const label = r.labels[ch];
							if (label && !labels.includes(label)) labels.push(label);
						}
					}
				}
				return map;
			}

			/**
			 * Playlistte aranan sanatçıyı bulur: arama sözcükleri (ve varsa
			 * birleşik hâli) ile playlistteki sanatçı adlarını karşılaştırır.
			 * En çok eşleşen sözcüğe sahip sanatçıyı döndürür (ad + parça sayısı).
			 */
			function artistMatch(it: Item, keys: string[]): { name: string; count: number } | null {
				if (it.ty !== 'playlist' || !it.ac || !it.ac.length || !keys.length) return null;
				let best: { name: string; count: number } | null = null;
				let bestScore = 0;
				for (const [di, count] of it.ac) {
					const name = ad[di];
					const folded = af[di];
					if (!folded) continue;
					// Sanatçı adının sözcükleri: "witchthroat serpent" -> [witchthroat, serpent].
					const words = folded.split(/\s+/).filter(Boolean);
					let score = 0;
					for (const k of keys) {
						if (!k) continue;
						// Tam ad eşleşmesi en güçlü.
						if (folded === k) score = Math.max(score, 3);
						// Tam sözcük eşleşmesi: "serpent" <-> "Witchthroat Serpent".
						else if (words.includes(k)) score = Math.max(score, 2);
						// Sözcük başı eşleşmesi: "serpent" -> "serpentcult".
						// Kısa anahtarlarda ("metal" -> "Metallica") yanlış eşleşmeyi
						// önlemek için en az 6 harf aranır.
						else if (k.length >= 6 && words.some((w) => w.startsWith(k))) score = Math.max(score, 2);
					}
					if (score > bestScore || (score === bestScore && best && count > best.count)) {
						bestScore = score;
						best = { name, count };
					}
				}
				return bestScore > 0 ? best : null;
			}

			function buildList(list: Item[], roleMap: Map<number, string[]>, keys: string[]) {
				grid!.replaceChildren();
				for (const it of list) {
					const node = (tpl.content.firstElementChild as HTMLElement | null)!.cloneNode(true) as HTMLElement;
					node.dataset.type = it.ty;
					node.dataset.title = it.ft;
					node.dataset.rating = String(it.r);
					node.dataset.year = it.y;
					node.dataset.review = String(it.rt);
					node.dataset.index = String(it.idx);
					const a = node.querySelector('a')!;
					a.href = it.u;
					const frame = node.querySelector('.frame') as HTMLElement | null;
					if (frame) {
						frame.classList.toggle('round', Boolean(it.rd));
						frame.classList.toggle('square', Boolean(it.sq));
					}
					const posterWrap = node.querySelector('.poster-wrap') as HTMLElement | null;
					const img = node.querySelector('img') as HTMLImageElement | null;
					if (img) {
						if (it.p) {
							img.src = it.p;
							img.alt = it.t;
						} else {
							img.removeAttribute('src');
							if (posterWrap) posterWrap.hidden = true;
						}
					}
					const t = node.querySelector('.title-text') as HTMLElement | null;
					if (t) t.textContent = it.t;
					const rank = node.querySelector('.rank') as HTMLElement | null;
					if (rank) {
						if (it.rk && it.rk > 0) {
							rank.textContent = `#${it.rk}`;
							rank.hidden = false;
						} else {
							rank.textContent = '';
							rank.hidden = true;
						}
					}
					const auth = node.querySelector('.author') as HTMLElement | null;
					if (auth) auth.textContent = it.a;
					const yr = node.querySelector('.year') as HTMLElement | null;
					if (yr) yr.textContent = it.s;
					const strip = node.querySelector('.type-strip') as HTMLElement | null;
					if (strip) strip.textContent = TYPE_STRIP[it.ty] ?? '';
					/* Aranan sanatçı bu playlistte varsa: "Sanatçı · N parça". */
					const matchEl = node.querySelector('.artist-match') as HTMLElement | null;
					if (matchEl) {
						const m = artistMatch(it, keys);
						if (m) {
							matchEl.textContent = `${m.name} · ${m.count} parça`;
							matchEl.hidden = false;
						} else {
							matchEl.textContent = '';
							matchEl.hidden = true;
						}
						/* Eşleşme varsa "N sanatçı" ve "N şarkı · süre" gizlenir. */
						node.classList.toggle('has-artist-match', Boolean(m));
					}
					const rolesEl = node.querySelector('.card-roles') as HTMLElement | null;
					if (rolesEl) {
						const labels = roleMap.get(it.idx);
						rolesEl.textContent = labels && labels.length ? labels.join(' · ') : '';
						rolesEl.hidden = !(labels && labels.length);
					}
					grid!.appendChild(node);
				}
			}

			function apply() {
				const rawQuery = fold(search.value.trim());
				const tokens = rawQuery.split(/\s+/).filter(Boolean);
				const tagTokens = tags.map((tag) => fold(tag));
				// Sanatçı eşleşmesi için: tam arama cümlesi + sözcükler + çipler.
				const keys = [rawQuery, ...tokens, ...tagTokens].filter(Boolean);
				const t = type.value;
				const needText = tokens.length > 0 || tagTokens.length > 0;
				const idle = !needText && !t;
				if (grid) grid.hidden = idle;
				if (status) status.hidden = idle;
				if (empty) empty.hidden = true;
				if (idle) {
					if (grid) grid.replaceChildren();
					return;
				}
				if (!loaded) {
					if (!err) load().then(apply);
					if (count) count.textContent = err ? 'Arama verisi yüklenemedi' : 'Aranıyor…';
					if (grid) grid.replaceChildren();
					return;
				}
				let res = items.filter((it) => {
					if (t && it.ty !== t) return false;
					if (tokens.length || tagTokens.length) {
						const qf = it.q + ' ' + it.ft;
						if (!tokens.every((tok) => qf.includes(tok))) return false;
						if (!tagTokens.every((tok) => qf.includes(tok))) return false;
					}
					return true;
				});
				const mode = sort.value;
				res = res.sort((a, b) => {
					switch (mode) {
						case 'rating':
							return (b.r ?? 0) - (a.r ?? 0);
						case 'year':
							return Number(b.y || 0) - Number(a.y || 0);
						case 'review':
							return (b.rt ?? 0) - (a.rt ?? 0);
						case 'title':
							return a.ft.localeCompare(b.ft, 'tr');
						default: {
							// İlgi anahtarı: arama kutusu ya da çip(ler)den gelen ilk sözcük.
							const key = tokens[0] ?? tagTokens[0];
							if (!key) return a.idx - b.idx;
							// Playlistler her zaman kendi içinde şarkı sayısına göre
							// sıralanır (çoktan aza); başlık eşleşmesi bu sırayı bozmaz.
							const ap = a.ty === 'playlist';
							const bp = b.ty === 'playlist';
							if (ap && bp) return (b.tc ?? 0) - (a.tc ?? 0) || a.idx - b.idx;
							// Kalan kayıtlarda: aranan sözcükle başlayan başlıklar önce.
							const pa = ap ? 1 : a.ft.startsWith(key) ? 0 : 1;
							const pb = bp ? 1 : b.ft.startsWith(key) ? 0 : 1;
							return pa - pb || a.idx - b.idx;
						}
					}
				});
				buildList(res, personRoles(), keys);
				if (count) count.textContent = `${res.length} kayıt`;
				if (empty) empty.hidden = res.length !== 0;
				// Tek tür seçiliyken (Tür = Film/Dizi/Kitap) kart şeridi gereksiz: gizle.
				root.classList.toggle('is-single-type', !!t);
				/* Sonuçlarda film/dizi/kitap yoksa (yalnız sanatçı, playlist,
				   müzik türü) 2:3 poster yüksekliği boşuna dikleştirir;
				   kapak alanı kareye iner. */
				root.classList.toggle('no-poster', !res.some((it) => POSTER_TYPES.has(it.ty)));
			}

			[search, type, sort].forEach((el) => el.addEventListener('input', apply));
			search.addEventListener('focus', load, { once: true });
			reset.addEventListener('click', () => {
				search.value = '';
				type.value = '';
				sort.value = 'relevant';
				tags.length = 0;
				renderChips();
				apply();
			});

			const params = new URLSearchParams(location.search);
			const q = params.get('q');
			if (q) {
				tags.push(q);
				renderChips();
			}
			const TUR_IDS = ['film', 'dizi', 'kitap', 'sanatci', 'playlist', 'muzik-tur'];
			if (params.get('tur')) {
				const tur = params.get('tur')!;
				if (TUR_IDS.includes(tur)) type.value = tur;
			}
			apply();
		});
	</script>

<style>
	.controls {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		align-items: flex-end;
		padding: 1rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
		margin-bottom: 1rem;
	}

	.chips {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 0.85rem;
	}
	.fchip {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.2rem 0.4rem 0.2rem 0.75rem;
		border: 1px solid var(--border-strong);
		border-radius: 999px;
		background: var(--accent-soft);
		color: var(--text);
		font-family: var(--font-ui);
		font-size: 0.84rem;
	}
	.fchip button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.2rem;
		height: 1.2rem;
		border: 0;
		border-radius: 50%;
		background: transparent;
		color: var(--text-muted);
		font-size: 1rem;
		line-height: 1;
		cursor: pointer;
	}
	.fchip button:hover {
		background: var(--border-strong);
		color: var(--text);
	}

	.search {
		flex: 1 1 260px;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-sm);
		background: var(--bg-2);
		padding: 0 0.75rem;
		height: 2.6rem;
	}
	.search:focus-within {
		border-color: var(--accent);
	}
	.search .icon {
		color: var(--text-muted);
		font-size: 1.1rem;
	}
	.search input {
		border: 0;
		background: transparent;
		color: var(--text);
		width: 100%;
		height: 100%;
		font-family: var(--font-ui);
		font-size: 0.95rem;
		outline: none;
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		font-family: var(--font-ui);
		font-size: 0.72rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--text-muted);
	}
	.field > span {
		padding-left: 0.15rem;
	}

	select {
		height: 2.6rem;
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-sm);
		background: var(--bg-2);
		color: var(--text);
		font-family: var(--font-ui);
		font-size: 0.82rem;
		padding: 0 0.6rem;
		min-width: 9rem;
	}
	select:focus {
		outline: none;
		border-color: var(--accent);
	}

	.reset {
		height: 2.6rem;
	}

	.status {
		margin-bottom: 0.75rem;
		font-size: 0.88rem;
	}

	.cell[hidden] {
		display: none;
	}

	/* Sanatçı kartı: tüm zamanlar sıralaması "#N". Başlık akışında kalır ki
	   iki satırlık -webkit-line-clamp bozulmasın. */
	.entry-card .rank {
		font-family: var(--font-ui);
		font-size: 0.72em;
		font-weight: 600;
		letter-spacing: 0.02em;
		color: var(--text-faint);
		margin-left: 0.4em;
		white-space: nowrap;
	}
	/* Kapak alanı: kare/yuvarlak kapaklarda da 2:3 poster yüksekliği korunur ki
	   altındaki tür şeridi tüm kartlarda aynı hizada dursun. Kapak ortalanır. */
	.entry-card .poster-wrap:has(.frame.square),
	.entry-card .poster-wrap:has(.frame.round) {
		aspect-ratio: var(--poster-ratio);
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
	}
	.entry-card .poster-wrap:has(.frame.round) {
		background: transparent;
	}
	/* Sanatçı kapağı: kare + yuvarlak, poster alanı içinde ortalanır. */
	.entry-card .frame.round {
		aspect-ratio: 1 / 1;
		border-radius: 50%;
		width: min(100%, 132px);
		height: auto;
		flex: none;
	}
	/* Playlist kapağı kare (Spotify kapakları 1:1); kart genişliğinde, ortalanır.
	   Yuvarlak sanatçı kapağı bu genişlik kuralından etkilenmez. */
	.entry-card .frame.square:not(.round) {
		aspect-ratio: 1 / 1;
		width: 100%;
		height: auto;
		flex: none;
	}
	/* Kapak görseli yoksa (tür kartları) boş çerçeve hiç gösterilmez. */
	.entry-card .poster-wrap[hidden] {
		display: none;
	}

	/* Sonuçlarda film/dizi/kitap yoksa (yalnız sanatçı, playlist, müzik türü)
	   2:3 poster yüksekliğini korumak boşuna: kapak alanı kareye iner.
	   Tür şeridi yine tüm kartlarda aynı hizada kalır. */
	.no-poster .entry-card .poster-wrap:has(.frame.square),
	.no-poster .entry-card .poster-wrap:has(.frame.round) {
